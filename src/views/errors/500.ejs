<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#12356a">
    <title>Something Went Wrong | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/script.js" defer></script>
</head>
<body class="error-page">
    <div class="error-card" role="alert">
        <div class="error-illustration" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 22s7-4.5 7-12a7 7 0 1 0-14 0c0 7.5 7 12 7 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 8v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="12" cy="16" r="1.2" fill="currentColor"/>
            </svg>
        </div>
        <p class="error-code">Error 500</p>
        <h1>Something Went Wrong</h1>
        <p class="error-message"><%= typeof message !== 'undefined' && message ? message : 'An unexpected error occurred on our end. Please try again in a few moments.' %></p>
        <div class="error-actions">
            <% var backUrl = '/';
               if (typeof user !== 'undefined' && user && user.role) {
                   if (user.role === 'admin') backUrl = '/admin/dashboard';
                   else if (user.role === 'staff') backUrl = '/staff/dashboard';
                   else if (user.role === 'student') backUrl = '/student/dashboard';
               } %>
            <a class="error-btn error-btn-primary" href="<%= backUrl %>"><span aria-hidden="true">&larr;</span> Back to Dashboard</a>
            <a class="error-btn error-btn-secondary" href="/">Go Home</a>
        </div>
    </div>
</body>
</html>
