<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#12356a">
    <title>Access Denied</title>
    <link rel="icon" type="image/png" href="/images/eduvoice-mark.png">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/script.js" defer></script>
</head>
<body class="error-page">
    <div class="error-card" role="alert">
        <div class="error-illustration" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 3 20 6v5.5c0 5.1-3.45 8.6-8 10.5-4.55-1.9-8-5.4-8-10.5V6l8-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M9.5 11 12 13.5l5-5" stroke="currentColor" stroke-width="0" fill="none"/>
                <path d="M15.4 15.4 8.6 8.6M8.6 15.4l6.8-6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
        </div>
        <p class="error-code">Error 403</p>
        <h1>Access Denied</h1>
        <p class="error-message"><%= typeof message !== 'undefined' && message ? message : 'You do not have permission to view this page.' %></p>
        <div class="error-actions">
            <% var backUrl = '/';
               if (typeof user !== 'undefined' && user && user.role) {
                   if (user.role === 'admin') backUrl = '/admin/dashboard';
                   else if (user.role === 'staff') backUrl = '/staff/dashboard';
                   else if (user.role === 'student') backUrl = '/student/dashboard';
               } %>
            <a class="error-btn error-btn-primary" href="<%= backUrl %>"><span aria-hidden="true">&larr;</span> Back to Dashboard</a>
            <a class="error-btn error-btn-secondary" href="/">Go Home</a>
        </div>
    </div>
</body>
</html>
