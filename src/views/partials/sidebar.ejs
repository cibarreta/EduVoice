<aside class="app-sidebar" id="app-sidebar" aria-label="<%= role.charAt(0).toUpperCase() + role.slice(1) %> navigation">
    <div class="sidebar-head">
        <a class="sidebar-brand" href="<%= role === 'admin' ? '/admin/dashboard' : role === 'staff' ? '/staff/dashboard' : '/student/dashboard' %>" aria-label="EduVoice dashboard">
            <span class="sidebar-brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
            </span>
            <span>EduVoice</span>
        </a>
        <button class="sidebar-toggle" type="button" aria-label="Close navigation menu" aria-expanded="true" aria-controls="app-sidebar" data-sidebar-close>
            <span></span><span></span><span></span>
        </button>
    </div>

    <div class="sidebar-role"><%= role.charAt(0).toUpperCase() + role.slice(1) %></div>

    <% if (typeof user !== 'undefined' && user) { %>
        <div class="sidebar-user">
            <div class="sidebar-user-name"><%= user.name || user.full_name || 'User' %></div>
            <% if (user.email) { %><div class="sidebar-user-email"><%= user.email %></div><% } %>
        </div>
    <% } %>

    <nav class="sidebar-nav" aria-label="Primary">
        <% if (role === 'student') { %>
            <div class="sidebar-nav-section">Overview</div>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'is-active' : '' %>" href="/student/dashboard" aria-current="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'page' : 'false' %>">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 13.5V20h6v-5h4v5h6v-6.5L12 4 4 13.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                Dashboard
            </a>
            <div class="sidebar-nav-section">Feedback</div>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'submit') ? 'is-active' : '' %>" href="/student/submit">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 8v6M9 11h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                Submit Feedback
            </a>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'my-feedback') ? 'is-active' : '' %>" href="/student/feedback">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 5h14v15H5zM5 9h14M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                My Feedback
            </a>
        <% } else if (role === 'admin') { %>
            <div class="sidebar-nav-section">Overview</div>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'is-active' : '' %>" href="/admin/dashboard" aria-current="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'page' : 'false' %>">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 13.5V20h6v-5h4v5h6v-6.5L12 4 4 13.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                Dashboard
            </a>
            <div class="sidebar-nav-section">Management</div>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'feedback') ? 'is-active' : '' %>" href="/admin/feedback">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                Manage Feedback
            </a>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'categories') ? 'is-active' : '' %>" href="/admin/categories">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                Categories
            </a>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'users') ? 'is-active' : '' %>" href="/admin/users">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M16 14a4 4 0 1 0-8 0M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM4 21c1.5-3.2 4.5-5 8-5s6.5 1.8 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                Users
            </a>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'staff') ? 'is-active' : '' %>" href="/admin/staff">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3 20 6v5.5c0 5.1-3.45 8.6-8 10.5-4.55-1.9-8-5.4-8-10.5V6l8-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                Staff Roles
            </a>
        <% } else if (role === 'staff') { %>
            <div class="sidebar-nav-section">Overview</div>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'is-active' : '' %>" href="/staff/dashboard" aria-current="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'page' : 'false' %>">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 13.5V20h6v-5h4v5h6v-6.5L12 4 4 13.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                Dashboard
            </a>
            <div class="sidebar-nav-section">Feedback</div>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'feedback') ? 'is-active' : '' %>" href="/staff/feedback">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                Review Feedback
            </a>
            <a class="sidebar-link <%= (typeof activePage !== 'undefined' && activePage === 'reports') ? 'is-active' : '' %>" href="/staff/reports">
                <span class="sidebar-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                Reports
            </a>
        <% } %>
    </nav>

    <div class="sidebar-foot">
        <form action="/logout" method="POST">
            <button class="sidebar-logout" type="submit">
                <span class="sidebar-logout-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 17l-5-5 5-5M5 12h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                Logout
            </button>
        </form>
    </div>
</aside>
<div class="sidebar-overlay" data-sidebar-overlay aria-hidden="true"></div>
