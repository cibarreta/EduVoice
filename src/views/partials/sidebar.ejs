<%
    const navRole = typeof role !== "undefined" && role
        ? role
        : (typeof user !== "undefined" && user ? user.role : "student");
    const navPath = typeof currentPath !== "undefined" ? currentPath : "";
    const dashboardPath = `/${navRole}/dashboard`;

    const iconSvg = (type) => {
        const common = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
        switch (type) {
            case "dashboard":
                return `<svg ${common}><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>`;
            case "feedback":
                return `<svg ${common}><path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z"/><path d="M8 12h8M8 8.8h5.5"/></svg>`;
            case "suggestion":
                return `<svg ${common}><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z"/></svg>`;
            case "submissions":
                return `<svg ${common}><path d="M5 5h14v15H5zM8 9h8M8 12.5h8M8 16h5"/><path d="M8 5V3h8v2"/></svg>`;
            case "users":
                return `<svg ${common}><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.7-3.4 3.3-5.3 6.5-5.3s5.8 1.9 6.5 5.3"/><circle cx="17" cy="9" r="2.7"/><path d="M15.5 19.8c.4-2.2 2-3.6 4-3.7 1.6-.1 3.1.9 3.8 2.7"/></svg>`;
            case "statistics":
                return `<svg ${common}><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>`;
            case "profile":
                return `<svg ${common}><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>`;
            case "notifications":
                return `<svg ${common}><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>`;
            case "audit":
                return `<svg ${common}><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg>`;
            case "logout":
                return `<svg ${common}><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h12"/></svg>`;
            default:
                return `<svg ${common}><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>`;
        }
    };

    let navLinks = [];
    if (navRole === "admin") {
        navLinks = [
            { label: "Dashboard", href: dashboardPath, icon: "dashboard" },
            { label: "Feedback", href: "/admin/feedback", icon: "feedback" },
            { label: "Suggestions", href: "/admin/suggestions", icon: "suggestion" },
            { label: "All Submissions", href: "/admin/submissions", icon: "submissions" },
            { label: "Users", href: "/admin/users", icon: "users" },
            { label: "Statistics", href: "/admin/statistics", icon: "statistics" },
            { label: "Audit Logs", href: "/admin/audit-logs", icon: "audit" },
            { label: "Notifications", href: "/notifications", icon: "notifications" },
            { label: "Profile", href: "/admin/profile", icon: "profile" }
        ];
    } else if (navRole === "staff") {
        navLinks = [
            { label: "Dashboard", href: dashboardPath, icon: "dashboard" },
            { label: "Submissions", href: "/staff/submissions", icon: "submissions" },
            { label: "Notifications", href: "/notifications", icon: "notifications" },
            { label: "Profile", href: "/staff/profile", icon: "profile" }
        ];
    } else {
        navLinks = [
            { label: "Dashboard", href: dashboardPath, icon: "dashboard" },
            { label: "Submit Feedback", href: "/student/submit-feedback", icon: "feedback" },
            { label: "Submit Suggestion", href: "/student/submit-suggestion", icon: "suggestion" },
            { label: "My Submissions", href: "/student/submissions", icon: "submissions" },
            { label: "Notifications", href: "/notifications", icon: "notifications" },
            { label: "Profile", href: "/student/profile", icon: "profile" }
        ];
    }
%>
<aside class="app-sidebar" id="app-sidebar" aria-label="<%= navRole.charAt(0).toUpperCase() + navRole.slice(1) %> navigation">
    <div class="sidebar-head">
        <a class="sidebar-brand" href="<%= dashboardPath %>" aria-label="EduVoice dashboard">
            <span class="sidebar-brand-icon" aria-hidden="true"><img src="/images/eduvoice-mark.png" alt=""></span>
            <span>EduVoice</span>
        </a>
        <button class="sidebar-close-btn" type="button" aria-label="Close navigation menu" aria-expanded="true" aria-controls="app-sidebar" data-sidebar-close>
            <span></span><span></span><span></span>
        </button>
    </div>

    <div class="sidebar-role"><%= navRole.charAt(0).toUpperCase() + navRole.slice(1) %></div>
    <% if (typeof user !== "undefined" && user) { %>
        <div class="sidebar-user">
            <div class="sidebar-user-name"><%= user.name || "User" %></div>
            <% if (user.email) { %><div class="sidebar-user-email"><%= user.email %></div><% } %>
        </div>
    <% } %>

    <nav class="sidebar-nav" aria-label="Primary">
        <% navLinks.forEach(item => {
            const isActive = navPath === item.href || (item.href !== dashboardPath && navPath.startsWith(`${item.href}/`));
        %>
            <a class="sidebar-link <%= isActive ? 'is-active' : '' %>" href="<%= item.href %>" <%= isActive ? 'aria-current="page"' : '' %>>
                <span class="sidebar-link-icon" aria-hidden="true"><%- iconSvg(item.icon) %></span>
                <span><%= item.label %></span>
            </a>
        <% }); %>
    </nav>

    <div class="sidebar-foot">
        <form action="/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button class="sidebar-logout" type="submit">
                <span class="sidebar-link-icon" aria-hidden="true"><%- iconSvg("logout") %></span>
                <span>Log out</span>
            </button>
        </form>
    </div>
</aside>
<button type="button" class="sidebar-overlay" data-sidebar-overlay aria-label="Close navigation" aria-hidden="true"></button>
