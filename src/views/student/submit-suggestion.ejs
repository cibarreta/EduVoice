<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head") %>
</head>
<body class="app-shell">
    <%- include("../partials/sidebar", { user: user, currentPath: "/student/submit-suggestion", role: "student" }) %>

    <div class="app-main-wrap">
        <header class="app-topbar">
            <button class="topbar-menu-btn" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-sidebar" data-sidebar-open>
                <span></span><span></span><span></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-user-avatar" aria-hidden="true">
                    <%= (typeof user !== 'undefined' && user && user.name ? user.name.charAt(0).toUpperCase() : 'S') %>
                </div>
                <div class="topbar-user-meta">
                    <strong><%= (typeof user !== 'undefined' && user ? user.name : 'Student') %></strong>
                    <span>Student</span>
                </div>
            </div>
        </header>

        <div class="app-alerts">
            <%- include("../partials/alerts") %>
        </div>

        <main class="app-content">
            <section class="page-header">
                <div>
                    <p class="eyebrow"><span class="eyebrow-dot"></span> Share Suggestion</p>
                    <h1>Submit Suggestion</h1>
                    <p class="page-subtitle">Propose ideas and improvements that can help your school community.</p>
                </div>
                <a class="button button-outline" href="/student/dashboard">&larr; Back to Dashboard</a>
            </section>

            <div class="form-card">
                <form class="submission-form" action="/student/submit-suggestion" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                    <div class="form-field">
                        <label for="title">Suggestion Title</label>
                        <div class="input-wrap">
                            <input
                                type="text"
                                id="title"
                                name="title"
                                maxlength="200"
                                placeholder="Briefly describe your suggestion"
                                required
                            >
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="category_id">Category</label>
                        <div class="input-wrap">
                            <select id="category_id" name="category_id" required>
                                <option value="">Select a category</option>
                                <% if (typeof categories !== 'undefined') { %>
                                    <% categories.forEach(category => { %>
                                        <option value="<%= category.id %>">
                                            <%= category.name %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="priority">Priority</label>
                        <div class="input-wrap">
                            <select id="priority" name="priority" required>
                                <option value="Low">Low</option>
                                <option value="Normal" selected>Normal</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="description">Description</label>
                        <div class="input-wrap">
                            <textarea
                                id="description"
                                name="description"
                                rows="7"
                                maxlength="10000"
                                placeholder="Explain your idea in detail and how it could benefit the school"
                                required
                            ></textarea>
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="attachments">Attachments (optional)</label>
                        <div class="input-wrap">
                            <input type="file" id="attachments" name="attachments" accept=".pdf,.jpg,.jpeg,.png,.gif,.webp" multiple>
                        </div>
                        <small>Up to 3 PDF or image files, 3 MB each.</small>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="is_anonymous" name="is_anonymous" value="1">
                        <label for="is_anonymous">Submit anonymously (your identity will not be shown to reviewers)</label>
                    </div>

                    <div class="form-actions">
                        <button class="button button-primary" type="submit">Submit Suggestion</button>
                        <a class="button button-outline" href="/student/dashboard">Cancel</a>
                    </div>
                </form>
            </div>
        </main>

        <footer class="app-footer">
            <p>&copy; 2026 EduVoice. All rights reserved.</p>
        </footer>
    </div>
</body>
</html>
