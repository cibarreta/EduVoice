<%- include("../partials/head") %>
<%- include("../partials/sidebar") %>

<main class="container">
    <%- include("../partials/alerts") %>

    <section class="page-header">
        <div>
            <p class="eyebrow"><span class="eyebrow-dot"></span> Share Suggestion</p>
            <h1>Submit Suggestion</h1>
            <p class="page-subtitle">Propose ideas and improvements that can help your school community.</p>
        </div>
        <a class="button button-outline" href="/student/dashboard">&larr; Back to Dashboard</a>
    </section>

    <div class="form-card">
        <form class="submission-form" action="/student/submit-suggestion" method="POST">

            <div class="form-field">
                <label for="title">Suggestion Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    maxlength="200"
                    placeholder="Briefly describe your suggestion"
                    required
                >
            </div>

            <div class="form-field">
                <label for="category_id">Category</label>
                <select id="category_id" name="category_id" required>
                    <option value="">Select a category</option>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.id %>">
                            <%= category.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-field">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="7"
                    placeholder="Explain your idea in detail and how it could benefit the school"
                    required
                ></textarea>
            </div>

            <div class="form-check">
                <input type="checkbox" id="is_anonymous" name="is_anonymous" value="1">
                <label for="is_anonymous">Submit anonymously (your identity will not be shown to reviewers)</label>
            </div>

            <div class="form-actions">
                <button class="button button-primary" type="submit">Submit Suggestion</button>
                <a class="button button-outline" href="/student/dashboard">Cancel</a>
            </div>
        </form>
    </div>
</main>

</body>
</html>
