<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head") %>
</head>
<body class="app-shell">
    <%- include("../partials/sidebar", { user: user, currentPath: "/student/dashboard", role: "student" }) %>

    <div class="app-main-wrap">
        <header class="app-topbar">
            <button class="topbar-menu-btn" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-sidebar" data-sidebar-open>
                <span></span><span></span><span></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-user-avatar" aria-hidden="true">
                    <%= (typeof user !== 'undefined' && user && user.name ? user.name.charAt(0).toUpperCase() : 'S') %>
                </div>
                <div class="topbar-user-meta">
                    <strong><%= (typeof user !== 'undefined' && user ? user.name : 'Student') %></strong>
                    <span>Student</span>
                </div>
            </div>
        </header>

        <div class="app-alerts">
            <%- include("../partials/alerts") %>
        </div>

        <main class="app-content">
            <section class="page-header">
                <div>
                    <p class="eyebrow"><span class="eyebrow-dot"></span> Student Dashboard</p>
                    <h1>Welcome, <%= user.name %>!</h1>
                    <p class="page-subtitle">Track your submissions and share your voice with the school.</p>
                </div>
            </section>

            <section class="stats-grid">
                <div class="stat-card stat-total">
                    <div class="stat-icon icon-blue">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 5h14v15H5zM8 9h8M8 12.5h8M8 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 5V3h8v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">Total Submissions</p>
                        <p class="stat-value"><%= stats.total %></p>
                    </div>
                </div>

                <div class="stat-card stat-pending">
                    <div class="stat-icon icon-orange">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/></svg>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">Pending</p>
                        <p class="stat-value"><%= stats.pending %></p>
                    </div>
                </div>

                <div class="stat-card stat-progress">
                    <div class="stat-icon icon-purple">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2 3 7v6c0 5 3.8 9.3 9 11 5.2-1.7 9-6 9-11V7l-9-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9 12 2.2 2.2 4.8-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">In Progress</p>
                        <p class="stat-value"><%= stats.in_progress %></p>
                    </div>
                </div>

                <div class="stat-card stat-resolved">
                    <div class="stat-icon icon-green">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 20 6v5.5c0 5.1-3.45 8.6-8 10.5-4.55-1.9-8-5.4-8-10.5V6l8-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.2 2.2 4.8-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">Resolved</p>
                        <p class="stat-value"><%= stats.resolved %></p>
                    </div>
                </div>
            </section>

            <section class="section-panel">
                <div class="section-panel-header">
                    <div>
                        <h2>Recent Submissions</h2>
                        <p>Your latest feedback and suggestions</p>
                    </div>
                    <a class="inline-link" href="/student/submissions">
                        View all <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>

                <% if (recentSubmissions.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M5 5h14v15H5zM8 9h8M8 12.5h8M8 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 5V3h8v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                        <h3>No submissions yet</h3>
                        <p>Share your first feedback or suggestion to get started.</p>
                        <a class="button button-primary" href="/student/submit-feedback">Share Your Feedback</a>
                    </div>
                <% } else { %>
                    <div class="submission-list">
                        <% recentSubmissions.forEach(item => { %>
                            <a class="submission-row" href="/student/submissions/<%= item.id %>">
                                <div class="submission-row-main">
                                    <div class="submission-row-type">
                                        <% if (item.type === 'feedback') { %>
                                            <span class="badge badge-type-feedback">Feedback</span>
                                        <% } else { %>
                                            <span class="badge badge-type-suggestion">Suggestion</span>
                                        <% } %>
                                    </div>
                                    <div class="submission-row-body">
                                        <h3 class="submission-row-title"><%= item.title %></h3>
                                        <p class="submission-row-meta">
                                            <span class="meta-category"><%= item.category_name || "Uncategorized" %></span>
                                            <span class="meta-date">
                                                <%= new Date(item.created_at).toLocaleDateString() %>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="submission-row-right">
                                    <% if (item.status === 'Pending') { %>
                                        <span class="badge badge-status-pending">Pending</span>
                                    <% } else if (item.status === 'In Progress' || item.status === 'Under Review') { %>
                                        <span class="badge badge-status-progress">In Progress</span>
                                    <% } else if (item.status === 'Resolved') { %>
                                        <span class="badge badge-status-resolved">Resolved</span>
                                    <% } else if (item.status === 'Review') { %>
                                        <span class="badge badge-status-review">Review</span>
                                    <% } else if (item.status === 'Rejected') { %>
                                        <span class="badge badge-status-rejected">Rejected</span>
                                    <% } else { %>
                                        <span class="badge badge-status-default"><%= item.status %></span>
                                    <% } %>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </main>

        <footer class="app-footer">
            <p>&copy; 2026 EduVoice. All rights reserved.</p>
        </footer>
    </div>
</body>
</html>
