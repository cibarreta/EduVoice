<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head") %>
</head>
<body class="app-shell">
    <%- include("../partials/sidebar", { user: user, currentPath: "/student/submissions", role: "student" }) %>

    <div class="app-main-wrap">
        <header class="app-topbar">
            <button class="topbar-menu-btn" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-sidebar" data-sidebar-open>
                <span></span><span></span><span></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-user-avatar" aria-hidden="true">
                    <%= (typeof user !== 'undefined' && user && user.name ? user.name.charAt(0).toUpperCase() : 'S') %>
                </div>
                <div class="topbar-user-meta">
                    <strong><%= (typeof user !== 'undefined' && user ? user.name : 'Student') %></strong>
                    <span>Student</span>
                </div>
            </div>
        </header>

        <div class="app-alerts">
            <%- include("../partials/alerts") %>
        </div>

        <main class="app-content">
            <section class="page-header">
                <div>
                    <p class="eyebrow"><span class="eyebrow-dot"></span> Your Submissions</p>
                    <h1>My Submissions</h1>
                    <p class="page-subtitle">View and track all your feedback and suggestions.</p>
                </div>
            </section>

            <div class="filter-tabs" role="tablist">
                <a class="filter-tab <%= (typeof currentFilter === 'undefined' || currentFilter === 'all') ? 'is-active' : '' %>" href="/student/submissions" role="tab">
                    All
                    <span class="tab-count"><%= typeof counts !== 'undefined' ? counts.all : (typeof submissions !== 'undefined' ? submissions.length : 0) %></span>
                </a>
                <a class="filter-tab <%= (typeof currentFilter !== 'undefined' && currentFilter === 'feedback') ? 'is-active' : '' %>" href="/student/submissions?type=feedback" role="tab">
                    Feedback
                    <span class="tab-count"><%= typeof counts !== 'undefined' ? counts.feedback : 0 %></span>
                </a>
                <a class="filter-tab <%= (typeof currentFilter !== 'undefined' && currentFilter === 'suggestion') ? 'is-active' : '' %>" href="/student/submissions?type=suggestion" role="tab">
                    Suggestions
                    <span class="tab-count"><%= typeof counts !== 'undefined' ? counts.suggestion : 0 %></span>
                </a>
            </div>

            <% if (typeof submissions !== 'undefined' && submissions.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 5h14v15H5zM8 9h8M8 12.5h8M8 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 5V3h8v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <h3>No submissions found</h3>
                    <% if (typeof currentFilter !== 'undefined' && currentFilter !== 'all') { %>
                        <p>You don't have any <%= currentFilter %> submissions yet.</p>
                    <% } else { %>
                        <p>You haven't submitted any feedback or suggestions yet.</p>
                    <% } %>
                    <a class="button button-primary" href="/student/submit-feedback">Share Your Feedback</a>
                </div>
            <% } else if (typeof submissions !== 'undefined') { %>

                <div class="table-wrapper">
                    <table class="submissions-table">
                        <thead>
                            <tr>
                                <th>Reference ID</th>
                                <th>Type</th>
                                <th>Subject</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% submissions.forEach(item => { %>
                                <tr>
                                    <td class="ref-id">#<%= item.id %></td>
                                    <td>
                                        <% if (item.type === 'feedback') { %>
                                            <span class="badge badge-type-feedback">Feedback</span>
                                        <% } else { %>
                                            <span class="badge badge-type-suggestion">Suggestion</span>
                                        <% } %>
                                    </td>
                                    <td class="subject-cell">
                                        <a href="/student/submissions/<%= item.id %>"><%= item.title %></a>
                                    </td>
                                    <td><%= item.category_name || "Uncategorized" %></td>
                                    <td><%= item.priority || "Normal" %></td>
                                    <td><%= new Date(item.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <% if (item.status === 'Pending') { %>
                                            <span class="badge badge-status-pending">Pending</span>
                                        <% } else if (item.status === 'In Progress' || item.status === 'Under Review') { %>
                                            <span class="badge badge-status-progress">In Progress</span>
                                        <% } else if (item.status === 'Resolved') { %>
                                            <span class="badge badge-status-resolved">Resolved</span>
                                        <% } else if (item.status === 'Review') { %>
                                            <span class="badge badge-status-review">Review</span>
                                        <% } else if (item.status === 'Rejected') { %>
                                            <span class="badge badge-status-rejected">Rejected</span>
                                        <% } else { %>
                                            <span class="badge badge-status-default"><%= item.status %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a class="button button-outline button-sm" href="/student/submissions/<%= item.id %>">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="cards-grid">
                    <% submissions.forEach(item => { %>
                        <article class="submission-card-item">
                            <div class="card-header">
                                <span class="ref-id">#<%= item.id %></span>
                                <% if (item.type === 'feedback') { %>
                                    <span class="badge badge-type-feedback">Feedback</span>
                                <% } else { %>
                                    <span class="badge badge-type-suggestion">Suggestion</span>
                                <% } %>
                            </div>
                            <h3 class="card-title">
                                <a href="/student/submissions/<%= item.id %>"><%= item.title %></a>
                            </h3>
                            <div class="card-meta">
                                <span class="meta-category"><%= item.category_name || "Uncategorized" %></span>
                                <span class="meta-date"><%= new Date(item.created_at).toLocaleDateString() %></span>
                            </div>
                            <div class="card-footer">
                                <% if (item.status === 'Pending') { %>
                                    <span class="badge badge-status-pending">Pending</span>
                                <% } else if (item.status === 'In Progress' || item.status === 'Under Review') { %>
                                    <span class="badge badge-status-progress">In Progress</span>
                                <% } else if (item.status === 'Resolved') { %>
                                    <span class="badge badge-status-resolved">Resolved</span>
                                <% } else if (item.status === 'Review') { %>
                                    <span class="badge badge-status-review">Review</span>
                                <% } else if (item.status === 'Rejected') { %>
                                    <span class="badge badge-status-rejected">Rejected</span>
                                <% } else { %>
                                    <span class="badge badge-status-default"><%= item.status %></span>
                                <% } %>
                                <a class="button button-outline button-sm" href="/student/submissions/<%= item.id %>">View Details</a>
                            </div>
                        </article>
                    <% }) %>
                </div>

                <% if (typeof pagination !== 'undefined' && pagination) { %>
                    <nav class="pagination" aria-label="Submission pagination">
                        <% if (pagination.prevUrl) { %>
                            <a class="pagination-link" href="<%= pagination.prevUrl %>">&larr; Previous</a>
                        <% } %>
                        <% if (pagination.nextUrl) { %>
                            <a class="pagination-link pagination-link-next" href="<%= pagination.nextUrl %>">Next &rarr;</a>
                        <% } %>
                    </nav>
                <% } %>

            <% } %>
        </main>

        <footer class="app-footer">
            <p>&copy; 2026 EduVoice. All rights reserved.</p>
        </footer>
    </div>
</body>
</html>
