<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Profile | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --navy: #12356a;
            --navy-dark: #0d2850;
            --blue: #2364bd;
            --blue-light: #4f91e8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --violet: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-500: #64748b;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7fb; color: var(--gray-900); margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: var(--navy); color: #fff; flex-shrink: 0; padding: 24px 0; }
        .sidebar-brand { display: flex; align-items: center; gap: 10px; padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand-icon { width: 38px; height: 38px; background: var(--blue); border-radius: 11px; display: grid; place-items: center; }
        .sidebar-brand-icon svg { width: 25px; height: 25px; color: #fff; }
        .sidebar-brand-name { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.04em; }
        .sidebar-menu { margin-top: 20px; padding: 0 12px; list-style: none; }
        .sidebar-menu li { margin: 4px 0; }
        .sidebar-menu a { display: block; padding: 11px 14px; border-radius: 9px; color: #c6d6ee; text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(79,145,232,0.15); color: #fff; }
        .sidebar-menu a.active { background: var(--warning); }
        .main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: #fff; border-bottom: 1px solid var(--gray-200); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar-title { font-size: 1.15rem; font-weight: 700; color: var(--navy-dark); }
        .topbar-user { display: flex; align-items: center; gap: 12px; }
        .topbar-user .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--warning); color: #fff; display: grid; place-items: center; font-weight: 700; }
        .topbar-user .user-name { font-weight: 650; font-size: 0.9rem; }
        .topbar-user .user-role { font-size: 0.78rem; color: var(--gray-500); }
        .page-content { padding: 28px 32px; flex: 1; max-width: 860px; }
        .page-header { margin-bottom: 26px; }
        .page-header h1 { font-size: 1.7rem; color: var(--navy-dark); letter-spacing: -0.03em; margin-bottom: 4px; }
        .page-header p { color: var(--gray-500); font-size: 0.93rem; }
        .alert { padding: 13px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
        .alert-success { background: #e8f6ee; color: #15803d; border: 1px solid #bbf7d0; }
        .alert-error { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
        .profile-header-card { background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%); border-radius: 16px; padding: 32px 28px; margin-bottom: 22px; color: #fff; box-shadow: 0 8px 24px rgba(18,53,106,0.18); position: relative; overflow: hidden; }
        .profile-header-card::before { content:''; position:absolute; right:-40px; top:-40px; width:180px; height:180px; border-radius:50%; background: rgba(255,255,255,0.07); }
        .profile-header-card::after { content:''; position:absolute; right:60px; bottom:-60px; width:140px; height:140px; border-radius:50%; background: rgba(255,255,255,0.05); }
        .profile-hero { display: flex; align-items: center; gap: 22px; position: relative; z-index: 1; }
        .profile-avatar-lg { width: 86px; height: 86px; border-radius: 50%; background: rgba(255,255,255,0.15); color: #fff; display: grid; place-items: center; font-size: 2.3rem; font-weight: 750; letter-spacing: -0.04em; border: 3px solid rgba(255,255,255,0.25); backdrop-filter: blur(4px); flex-shrink: 0; }
        .profile-hero-info h2 { font-size: 1.55rem; letter-spacing: -0.025em; margin-bottom: 4px; }
        .profile-hero-info .email { color: rgba(255,255,255,0.82); font-size: 0.92rem; margin-bottom: 10px; }
        .profile-hero-tags { display: flex; gap: 8px; }
        .tag-pill { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 0.74rem; font-weight: 700; background: rgba(255,255,255,0.18); color: #fff; letter-spacing: 0.03em; }
        .panel { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); margin-bottom: 20px; box-shadow: 0 2px 10px rgba(15,23,42,0.04); overflow: hidden; }
        .panel-header { padding: 18px 24px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .panel-header h2 { font-size: 1rem; font-weight: 700; color: var(--navy-dark); display: flex; align-items: center; gap: 10px; }
        .panel-header h2 .ico { width: 32px; height: 32px; border-radius: 9px; background: #eef4ff; color: var(--navy); display: grid; place-items: center; }
        .panel-header h2 .ico.b { background: #fff7e6; color: #b45309; }
        .panel-header h2 .ico svg { width: 16px; height: 16px; }
        .panel-body { padding: 24px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; }
        .field.full { grid-column: 1 / -1; }
        .field:last-child { margin-bottom: 0; }
        .field label { font-size: 0.83rem; font-weight: 700; color: var(--gray-700); display: flex; align-items: center; justify-content: space-between; }
        .field label .hint { color: var(--gray-500); font-weight: 500; font-size: 0.76rem; }
        .field input { padding: 11px 13px; border: 1px solid var(--gray-300); border-radius: 9px; font-size: 0.92rem; color: var(--gray-900); background: #fff; font-family: inherit; transition: border 0.15s, box-shadow 0.15s; }
        .field input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(79,145,232,0.18); }
        .field input:disabled { background: var(--gray-50); color: var(--gray-500); cursor: not-allowed; }
        .password-hint { font-size: 0.78rem; color: var(--gray-500); line-height: 1.5; margin-top: -6px; margin-bottom: 14px; padding-left: 2px; }
        .password-hint ul { margin: 4px 0 0 18px; }
        .password-hint li { margin: 2px 0; }
        .btn { padding: 11px 20px; border-radius: 9px; font-size: 0.9rem; font-weight: 650; font-family: inherit; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.15s; }
        .btn-primary { background: var(--navy); color: #fff; }
        .btn-primary:hover { background: var(--navy-dark); }
        .btn-accent { background: var(--blue); color: #fff; }
        .btn-accent:hover { background: #1d4ed8; }
        .btn-outline { background: #fff; color: var(--navy-dark); border: 1px solid var(--gray-300); }
        .btn-outline:hover { background: var(--gray-50); }
        .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--gray-100); }
        .readonly-info { background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: 10px; padding: 14px 16px; margin-bottom: 18px; }
        .readonly-info h4 { font-size: 0.78rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; font-weight: 700; }
        .readonly-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .readonly-item label { display: block; font-size: 0.72rem; color: var(--gray-500); font-weight: 650; margin-bottom: 3px; }
        .readonly-item span { font-size: 0.9rem; color: var(--gray-900); font-weight: 500; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="sidebar-brand-name">EduVoice</span>
            </div>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a></li>
                <li><a href="/admin/feedback">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Feedback
                </a></li>
                <li><a href="/admin/suggestions">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Suggestions
                </a></li>
                <li><a href="/admin/users">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Users
                </a></li>
                <li><a href="/admin/statistics">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Statistics
                </a></li>
                <li><a href="/admin/profile" class="active">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a></li>
            </ul>
        </aside>
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-title">My Profile</div>
                <div class="topbar-user">
                    <div style="text-align:right;">
                        <div class="user-name"><%= user ? user.name : 'Admin' %></div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <div class="avatar"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                </div>
            </header>
            <main class="page-content">

                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <div class="page-header">
                    <h1>Admin Profile</h1>
                    <p>Manage your account details and credentials.</p>
                </div>

                <div class="profile-header-card">
                    <div class="profile-hero">
                        <div class="profile-avatar-lg"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                        <div class="profile-hero-info">
                            <h2><%= user ? (user.name || 'Administrator') : 'Administrator' %></h2>
                            <div class="email"><%= user ? (user.email || 'no-email@edovoice.edu') : 'no-email@edovoice.edu' %></div>
                            <div class="profile-hero-tags">
                                <span class="tag-pill">Administrator</span>
                                <% if (user && user.created_at) { %>
                                    <span class="tag-pill">Since <%= new Date(user.created_at).toLocaleDateString() %></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h2>
                            <span class="ico">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </span>
                            Update Profile
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div class="readonly-info">
                            <h4>Account Credentials</h4>
                            <div class="readonly-grid">
                                <div class="readonly-item">
                                    <label>Email Address</label>
                                    <span><%= user ? (user.email || 'Not set') : 'Not set' %></span>
                                </div>
                                <div class="readonly-item">
                                    <label>Role</label>
                                    <span>Administrator</span>
                                </div>
                            </div>
                        </div>

                        <form method="POST" action="/admin/profile">
                            <div class="form-grid">
                                <div class="field full">
                                    <label for="name">Display Name</label>
                                    <input id="name" name="name" type="text" value="<%= user ? (user.name || '') : '' %>" placeholder="Enter your full name" required>
                                </div>
                            </div>
                            <div class="form-actions">
                                <button type="reset" class="btn btn-outline">Reset</button>
                                <button type="submit" class="btn btn-primary">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                    Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h2>
                            <span class="ico b">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </span>
                            Change Password
                        </h2>
                    </div>
                    <div class="panel-body">
                        <form method="POST" action="/admin/profile/password">
                            <div class="field">
                                <label for="currentPassword">Current Password</label>
                                <input id="currentPassword" name="currentPassword" type="password" placeholder="Enter your current password" required>
                            </div>
                            <div class="form-grid">
                                <div class="field">
                                    <label for="newPassword">New Password <span class="hint">min 8 characters</span></label>
                                    <input id="newPassword" name="newPassword" type="password" placeholder="Create a new password" required minlength="8">
                                </div>
                                <div class="field">
                                    <label for="confirmPassword">Confirm New Password</label>
                                    <input id="confirmPassword" name="confirmPassword" type="password" placeholder="Re-enter new password" required minlength="8">
                                </div>
                            </div>
                            <div class="password-hint">
                                Strong password requirements:
                                <ul>
                                    <li>At least 8 characters long</li>
                                    <li>Include uppercase and lowercase letters</li>
                                    <li>Include numbers or special characters</li>
                                </ul>
                            </div>
                            <div class="form-actions">
                                <button type="reset" class="btn btn-outline">Clear</button>
                                <button type="submit" class="btn btn-accent">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    Update Password
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </main>
        </div>
    </div>
</body>
</html>
