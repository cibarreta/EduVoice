<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submission Details | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --navy: #12356a;
            --navy-dark: #0d2850;
            --blue: #2364bd;
            --blue-light: #4f91e8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --violet: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-500: #64748b;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7fb; color: var(--gray-900); margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: var(--navy); color: #fff; flex-shrink: 0; padding: 24px 0; }
        .sidebar-brand { display: flex; align-items: center; gap: 10px; padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand-icon { width: 38px; height: 38px; background: var(--blue); border-radius: 11px; display: grid; place-items: center; }
        .sidebar-brand-icon svg { width: 25px; height: 25px; color: #fff; }
        .sidebar-brand-name { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.04em; }
        .sidebar-menu { margin-top: 20px; padding: 0 12px; list-style: none; }
        .sidebar-menu li { margin: 4px 0; }
        .sidebar-menu a { display: block; padding: 11px 14px; border-radius: 9px; color: #c6d6ee; text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(79,145,232,0.15); color: #fff; }
        .sidebar-menu a.active { background: var(--blue); }
        .main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: #fff; border-bottom: 1px solid var(--gray-200); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar-title { font-size: 1.15rem; font-weight: 700; color: var(--navy-dark); }
        .topbar-user { display: flex; align-items: center; gap: 12px; }
        .topbar-user .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-weight: 700; }
        .topbar-user .user-name { font-weight: 650; font-size: 0.9rem; }
        .topbar-user .user-role { font-size: 0.78rem; color: var(--gray-500); }
        .page-content { padding: 28px 32px; flex: 1; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: var(--blue); font-weight: 600; text-decoration: none; margin-bottom: 16px; }
        .page-header { margin-bottom: 22px; }
        .page-header h1 { font-size: 1.55rem; color: var(--navy-dark); letter-spacing: -0.025em; margin-bottom: 6px; }
        .page-header p { color: var(--gray-500); font-size: 0.9rem; }
        .content-grid { display: grid; grid-template-columns: 1fr 340px; gap: 24px; }
        .panel { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); margin-bottom: 22px; box-shadow: 0 2px 10px rgba(15,23,42,0.04); overflow: hidden; }
        .panel-header { padding: 18px 22px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .panel-header h2 { font-size: 1rem; font-weight: 700; color: var(--navy-dark); }
        .panel-body { padding: 22px; }
        .alert { padding: 13px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
        .alert-success { background: #e8f6ee; color: #15803d; border: 1px solid #bbf7d0; }
        .alert-error { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
        .badge { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 650; line-height: 1.3; }
        .badge-amber { background: #fff7e6; color: #b45309; }
        .badge-blue { background: #e8f1ff; color: #1e40af; }
        .badge-violet { background: #f3efff; color: #6d28d9; }
        .badge-green { background: #e8f6ee; color: #15803d; }
        .badge-red { background: #fdeeee; color: #b91c1c; }
        .badge-navy { background: #e8efff; color: var(--navy); }
        .title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
        .title-row h2 { font-size: 1.25rem; color: var(--navy-dark); letter-spacing: -0.02em; line-height: 1.35; }
        .meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin: 18px 0 22px; padding: 18px; background: var(--gray-50); border-radius: 12px; }
        .meta-item label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 5px; }
        .meta-item .meta-val { font-size: 0.93rem; color: var(--gray-900); font-weight: 500; }
        .student-card { display: flex; align-items: center; gap: 14px; padding: 18px; background: linear-gradient(135deg, #eef4ff 0%, #f8faff 100%); border-radius: 12px; border: 1px solid #d9e6f7; }
        .student-avatar { width: 54px; height: 54px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-size: 1.2rem; font-weight: 750; flex-shrink: 0; }
        .student-info strong { display: block; font-size: 1rem; color: var(--navy-dark); margin-bottom: 3px; }
        .student-info span { display: block; font-size: 0.82rem; color: var(--gray-500); }
        .description-box { padding: 18px; background: var(--gray-50); border-radius: 10px; line-height: 1.7; color: var(--gray-700); font-size: 0.94rem; border: 1px solid var(--gray-200); white-space: pre-wrap; }
        .field { margin-bottom: 14px; }
        .field:last-child { margin-bottom: 0; }
        .field label { display: block; font-size: 0.82rem; font-weight: 700; color: var(--gray-700); margin-bottom: 7px; }
        .field input, .field select, .field textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.9rem; color: var(--gray-900); background: #fff; font-family: inherit; transition: border 0.15s, box-shadow 0.15s; }
        .field textarea { resize: vertical; min-height: 110px; line-height: 1.6; }
        .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(79,145,232,0.18); }
        .btn { padding: 10px 18px; border-radius: 8px; font-size: 0.88rem; font-weight: 650; font-family: inherit; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.15s; }
        .btn-primary { background: var(--navy); color: #fff; }
        .btn-primary:hover { background: var(--navy-dark); }
        .btn-accent { background: var(--blue); color: #fff; }
        .btn-accent:hover { background: #1d4ed8; }
        .btn-outline { background: #fff; color: var(--navy-dark); border: 1px solid var(--gray-300); }
        .btn-outline:hover { background: var(--gray-50); }
        .form-row { display: flex; gap: 10px; margin-top: 4px; }
        .responses-list { display: flex; flex-direction: column; gap: 14px; }
        .response-card { padding: 16px 18px; border-radius: 11px; background: var(--gray-50); border: 1px solid var(--gray-200); }
        .response-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; gap: 12px; }
        .response-author { display: flex; align-items: center; gap: 10px; }
        .response-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-size: 0.85rem; font-weight: 700; }
        .response-author strong { color: var(--navy-dark); font-size: 0.9rem; }
        .response-author small { display: block; color: var(--gray-500); font-size: 0.74rem; margin-top: 2px; }
        .response-date { font-size: 0.78rem; color: var(--gray-500); }
        .response-body { color: var(--gray-700); line-height: 1.65; font-size: 0.92rem; white-space: pre-wrap; }
        .empty-responses { padding: 36px 20px; text-align: center; color: var(--gray-500); }
        .empty-responses .empty-icon { width: 52px; height: 52px; margin: 0 auto 12px; border-radius: 16px; background: var(--gray-100); display: grid; place-items: center; color: var(--gray-500); }
        .empty-responses .empty-icon svg { width: 26px; height: 26px; }
        .empty-responses h4 { font-size: 0.98rem; color: var(--navy-dark); margin-bottom: 5px; }
        .ref-id { font-family: 'Consolas', monospace; font-size: 0.85rem; color: var(--gray-500); font-weight: 600; }
        .divider { height: 1px; background: var(--gray-200); margin: 18px 0; }
        .tag { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 7px; background: var(--gray-100); color: var(--gray-700); font-size: 0.78rem; font-weight: 600; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="sidebar-brand-name">EduVoice</span>
            </div>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a></li>
                <li><a href="/admin/feedback" class="active">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Feedback
                </a></li>
                <li><a href="/admin/suggestions">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Suggestions
                </a></li>
                <li><a href="/admin/users">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Users
                </a></li>
                <li><a href="/admin/statistics">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Statistics
                </a></li>
                <li><a href="/admin/profile">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a></li>
            </ul>
        </aside>
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-title">Submission Details</div>
                <div class="topbar-user">
                    <div style="text-align:right;">
                        <div class="user-name"><%= user ? user.name : 'Admin' %></div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <div class="avatar"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                </div>
            </header>
            <main class="page-content">

                <a href="/admin/<%= typeof submission !== 'undefined' && submission && submission.type === 'suggestion' ? 'suggestions' : 'feedback' %>" class="back-link">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Back to list
                </a>

                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <% if (typeof submission !== 'undefined' && submission) { %>

                    <div class="content-grid">
                        <div>

                            <div class="panel">
                                <div class="panel-body">
                                    <div class="title-row">
                                        <h2><%= submission.title %></h2>
                                        <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
                                            <% if (typeof submission.reference !== 'undefined' && submission.reference) { %>
                                                <span class="ref-id">Ref: <%= submission.reference %></span>
                                            <% } %>
                                            <% if (submission.type === 'suggestion') { %>
                                                <span class="badge badge-violet">Suggestion</span>
                                            <% } else { %>
                                                <span class="badge badge-blue">Feedback</span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="meta-grid">
                                        <div class="meta-item">
                                            <label>Category</label>
                                            <div class="meta-val"><%= submission.category_name || 'Uncategorized' %></div>
                                        </div>
                                        <div class="meta-item">
                                            <label>Status</label>
                                            <div class="meta-val">
                                                <% if (submission.status === 'Pending') { %>
                                                    <span class="badge badge-amber">Pending</span>
                                                <% } else if (submission.status === 'Under Review') { %>
                                                    <span class="badge badge-blue">Under Review</span>
                                                <% } else if (submission.status === 'In Progress') { %>
                                                    <span class="badge badge-violet">In Progress</span>
                                                <% } else if (submission.status === 'Resolved') { %>
                                                    <span class="badge badge-green">Resolved</span>
                                                <% } else if (submission.status === 'Rejected') { %>
                                                    <span class="badge badge-red">Rejected</span>
                                                <% } else { %>
                                                    <span class="badge badge-blue"><%= submission.status %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="meta-item">
                                            <label>Submitted</label>
                                            <div class="meta-val"><%= new Date(submission.created_at).toLocaleString() %></div>
                                        </div>
                                        <div class="meta-item">
                                            <label>Assigned To</label>
                                            <div class="meta-val">
                                                <% if (typeof submission.assigned_staff_name !== 'undefined' && submission.assigned_staff_name) { %>
                                                    <%= submission.assigned_staff_name %>
                                                <% } else { %>
                                                    <span style="color:var(--gray-500);">Unassigned</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="margin-bottom:14px;font-size:0.82rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;">Description</div>
                                    <div class="description-box"><%= submission.description %></div>
                                </div>
                            </div>

                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Response History</h2>
                                    <span class="tag">
                                        <%= typeof responses !== 'undefined' && responses ? responses.length : 0 %> response(s)
                                    </span>
                                </div>
                                <div class="panel-body">
                                    <% if (typeof responses !== 'undefined' && responses && responses.length) { %>
                                        <div class="responses-list">
                                            <% responses.forEach(function(resp) { %>
                                                <article class="response-card">
                                                    <div class="response-head">
                                                        <div class="response-author">
                                                            <div class="response-avatar"><%= resp.admin_name ? resp.admin_name.charAt(0).toUpperCase() : 'A' %></div>
                                                            <div>
                                                                <strong><%= resp.admin_name || 'Admin' %></strong>
                                                                <small>
                                                                    <% if (typeof resp.admin_role !== 'undefined' && resp.admin_role) { %><%= resp.admin_role %><% } else { %>Administrator<% } %>
                                                                </small>
                                                            </div>
                                                        </div>
                                                        <div class="response-date"><%= new Date(resp.created_at).toLocaleString() %></div>
                                                    </div>
                                                    <div class="response-body"><%= resp.response %></div>
                                                </article>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <div class="empty-responses">
                                            <div class="empty-icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                            </div>
                                            <h4>No responses yet</h4>
                                            <p style="font-size:0.86rem;">Send your first response to the student below.</p>
                                        </div>
                                    <% } %>

                                    <div class="divider"></div>

                                    <h3 style="font-size:0.95rem;color:var(--navy-dark);margin-bottom:14px;">Send a Response</h3>
                                    <form method="POST" action="/admin/submissions/<%= submission.id %>/respond">
                                        <div class="field">
                                            <label for="response">Your message to the student</label>
                                            <textarea id="response" name="response" placeholder="Write a response that will be sent to the student..." required></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-accent">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                            Send Response
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>

                        <div>
                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Student Information</h2>
                                </div>
                                <div class="panel-body">
                                    <div class="student-card">
                                        <div class="student-avatar">
                                            <% var sname = (typeof submission.student_name && !submission.is_anonymous) ? submission.student_name : 'A';
                                            %><%= sname ? sname.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                        <div class="student-info">
                                            <% if (submission.is_anonymous) { %>
                                                <strong>Anonymous</strong>
                                                <span>Student chose anonymity</span>
                                            <% } else { %>
                                                <strong><%= submission.student_name || 'Unknown' %></strong>
                                                <% if (submission.student_id) { %><span>ID: <%= submission.student_id %></span><% } %>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--gray-200);">
                                        <div style="margin-bottom:12px;">
                                            <div style="font-size:0.76rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Email</div>
                                            <div style="font-size:0.9rem;color:var(--gray-900);font-weight:500;word-break:break-all;">
                                                <% if (submission.is_anonymous) { %>
                                                    <span style="color:var(--gray-500);">••••••••@email.com</span>
                                                <% } else { %>
                                                    <%= submission.student_email || '—' %>
                                                <% } %>
                                            </div>
                                        </div>
                                        <% if (!submission.is_anonymous && submission.student_id) { %>
                                            <div>
                                                <div style="font-size:0.76rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Student ID</div>
                                                <div style="font-size:0.9rem;color:var(--gray-900);font-weight:500;"><%= submission.student_id %></div>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Update Status</h2>
                                </div>
                                <div class="panel-body">
                                    <form method="POST" action="/admin/submissions/<%= submission.id %>/status">
                                        <div class="field">
                                            <label for="status">Current status</label>
                                            <select id="status" name="status" required>
                                                <% ['Pending','Under Review','In Progress','Resolved','Rejected'].forEach(function(st) { %>
                                                    <option value="<%= st %>" <%= submission.status === st ? 'selected' : '' %>><%= st %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-primary" style="width:100%;">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                            Update Status
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Assign Staff</h2>
                                </div>
                                <div class="panel-body">
                                    <form method="POST" action="/admin/submissions/<%= submission.id %>/assign">
                                        <div class="field">
                                            <label for="assignedStaff">Assign to staff member</label>
                                            <select id="assignedStaff" name="assignedStaff">
                                                <option value="">— Unassigned —</option>
                                                <% if (typeof staffUsers !== 'undefined' && staffUsers && staffUsers.length) { %>
                                                    <% staffUsers.forEach(function(staff) { %>
                                                        <option value="<%= staff.id %>" <%= (typeof submission.assigned_staff_id !== 'undefined' && submission.assigned_staff_id == staff.id) ? 'selected' : '' %>>
                                                            <%= staff.name %> <% if (staff.email) { %>(<%= staff.email %>)<% } %>
                                                        </option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-outline" style="width:100%;">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                                            Assign
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                <% } %>

            </main>
        </div>
    </div>
</body>
</html>
