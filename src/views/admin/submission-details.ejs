<!DOCTYPE html>
<html lang="en">
<head>
    <% var title = "Submission Details"; %>
    <%- include("../partials/head") %>
</head>
<body class="app-shell">
    <%- include("../partials/sidebar", { user: user, currentPath: "/admin/submissions", role: "admin" }) %>

    <div class="app-main-wrap">
        <header class="app-topbar">
            <button class="topbar-menu-btn" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-sidebar" data-sidebar-open>
                <span></span><span></span><span></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-user-avatar" aria-hidden="true">
                    <%= (typeof user !== 'undefined' && user && user.name ? user.name.charAt(0).toUpperCase() : 'A') %>
                </div>
                <div class="topbar-user-meta">
                    <strong><%= (typeof user !== 'undefined' && user ? user.name : 'Admin') %></strong>
                    <span>Admin</span>
                </div>
            </div>
        </header>

        <div class="app-alerts">
            <%- include("../partials/alerts") %>
        </div>

        <main class="app-content">
            <a href="/admin/<%= typeof submission !== 'undefined' && submission && submission.type === 'suggestion' ? 'suggestions' : 'feedback' %>" class="back-link">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to list
            </a>

            <% if (typeof submission !== 'undefined' && submission) { %>

                <div class="content-grid">
                    <div>

                        <div class="panel">
                            <div class="panel-body">
                                <div class="title-row" style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px;">
                                    <h2 style="font-size:1.25rem;color:var(--navy-dark);letter-spacing:-0.02em;line-height:1.35;"><%= submission.title %></h2>
                                    <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
                                        <% if (typeof submission.reference !== 'undefined' && submission.reference) { %>
                                            <span class="ref-id" style="font-family:'Consolas',monospace;font-size:0.85rem;color:var(--gray-500);font-weight:600;">Ref: <%= submission.reference %></span>
                                        <% } %>
                                        <% if (submission.type === 'suggestion') { %>
                                            <span class="badge badge-violet">Suggestion</span>
                                        <% } else { %>
                                            <span class="badge badge-blue">Feedback</span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="meta-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:18px 0 22px;padding:18px;background:var(--gray-50);border-radius:12px;">
                                    <div class="meta-item">
                                        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Category</label>
                                        <div class="meta-val" style="font-size:0.93rem;color:var(--gray-900);font-weight:500;"><%= submission.category_name || 'Uncategorized' %></div>
                                    </div>
                                    <div class="meta-item">
                                        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Status</label>
                                        <div class="meta-val" style="font-size:0.93rem;color:var(--gray-900);font-weight:500;">
                                            <% if (submission.status === 'Pending') { %>
                                                <span class="badge badge-amber">Pending</span>
                                            <% } else if (submission.status === 'Under Review') { %>
                                                <span class="badge badge-blue">Under Review</span>
                                            <% } else if (submission.status === 'In Progress') { %>
                                                <span class="badge badge-violet">In Progress</span>
                                            <% } else if (submission.status === 'Resolved') { %>
                                                <span class="badge badge-green">Resolved</span>
                                            <% } else if (submission.status === 'Rejected') { %>
                                                <span class="badge badge-red">Rejected</span>
                                            <% } else { %>
                                                <span class="badge badge-blue"><%= submission.status %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="meta-item">
                                        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Submitted</label>
                                        <div class="meta-val" style="font-size:0.93rem;color:var(--gray-900);font-weight:500;"><%= new Date(submission.created_at).toLocaleString() %></div>
                                    </div>
                                    <div class="meta-item">
                                        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Assigned To</label>
                                        <div class="meta-val" style="font-size:0.93rem;color:var(--gray-900);font-weight:500;">
                                            <% if (typeof submission.assigned_name !== 'undefined' && submission.assigned_name) { %>
                                                <%= submission.assigned_name %>
                                            <% } else { %>
                                                <span style="color:var(--gray-500);">Unassigned</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="meta-item">
                                        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Priority</label>
                                        <div class="meta-val" style="font-size:0.93rem;color:var(--gray-900);font-weight:500;"><%= submission.priority || 'Normal' %></div>
                                    </div>
                                    <div class="meta-item">
                                        <label style="display:block;font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Department</label>
                                        <div class="meta-val" style="font-size:0.93rem;color:var(--gray-900);font-weight:500;"><%= submission.department_name || 'Unassigned' %></div>
                                    </div>
                                </div>

                                <div style="margin-bottom:14px;font-size:0.82rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;">Description</div>
                                <div class="description-box" style="padding:18px;background:var(--gray-50);border-radius:10px;line-height:1.7;color:var(--gray-700);font-size:0.94rem;border:1px solid var(--gray-200);white-space:pre-wrap;"><%= submission.description %></div>
                                <% if (submission.resolution_notes) { %>
                                    <div style="margin-top:16px;padding:16px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;">
                                        <strong>Resolution notes</strong><p style="margin-top:8px;white-space:pre-wrap;"><%= submission.resolution_notes %></p>
                                    </div>
                                <% } %>
                                <% if (attachments && attachments.length) { %>
                                    <div style="margin-top:16px;">
                                        <strong>Attachments</strong>
                                        <ul><% attachments.forEach(file => { %><li><a href="/attachments/<%= file.id %>"><%= file.original_name %></a> (<%= Math.ceil(file.size_bytes / 1024) %> KB)</li><% }) %></ul>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel-header">
                                <h2>Response History</h2>
                                <span class="tag" style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:7px;background:var(--gray-100);color:var(--gray-700);font-size:0.78rem;font-weight:600;">
                                    <%= typeof responses !== 'undefined' && responses ? responses.length : 0 %> response(s)
                                </span>
                            </div>
                            <div class="panel-body">
                                <% if (typeof responses !== 'undefined' && responses && responses.length) { %>
                                    <div class="responses-list" style="display:flex;flex-direction:column;gap:14px;">
                                        <% responses.forEach(function(resp) { %>
                                            <article class="response-card" style="padding:16px 18px;border-radius:11px;background:var(--gray-50);border:1px solid var(--gray-200);">
                                                <div class="response-head" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:12px;">
                                                    <div class="response-author" style="display:flex;align-items:center;gap:10px;">
                                                        <div class="response-avatar" style="width:36px;height:36px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:0.85rem;font-weight:700;"><%= resp.admin_name ? resp.admin_name.charAt(0).toUpperCase() : 'A' %></div>
                                                        <div>
                                                            <strong style="color:var(--navy-dark);font-size:0.9rem;"><%= resp.admin_name || 'Admin' %></strong>
                                                            <small style="display:block;color:var(--gray-500);font-size:0.74rem;margin-top:2px;">
                                                                <% if (typeof resp.admin_role !== 'undefined' && resp.admin_role) { %><%= resp.admin_role %><% } else { %>Administrator<% } %>
                                                            </small>
                                                        </div>
                                                    </div>
                                                    <div class="response-date" style="font-size:0.78rem;color:var(--gray-500);"><%= new Date(resp.created_at).toLocaleString() %></div>
                                                </div>
                                                <div class="response-body" style="color:var(--gray-700);line-height:1.65;font-size:0.92rem;white-space:pre-wrap;"><%= resp.response %></div>
                                            </article>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="empty-responses" style="padding:36px 20px;text-align:center;color:var(--gray-500);">
                                        <div class="empty-icon" style="width:52px;height:52px;margin:0 auto 12px;border-radius:16px;background:var(--gray-100);display:grid;place-items:center;color:var(--gray-500);">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                        </div>
                                        <h4 style="font-size:0.98rem;color:var(--navy-dark);margin-bottom:5px;">No responses yet</h4>
                                        <p style="font-size:0.86rem;">Send your first response to the student below.</p>
                                    </div>
                                <% } %>

                                <div class="divider" style="height:1px;background:var(--gray-200);margin:18px 0;"></div>

                                <h3 style="font-size:0.95rem;color:var(--navy-dark);margin-bottom:14px;">Send a Response</h3>
                                <form method="POST" action="/admin/submissions/<%= submission.id %>/respond">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <div class="field">
                                        <label for="response">Your message to the student</label>
                                        <textarea id="response" name="response" placeholder="Write a response that will be sent to the student..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-accent">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                        Send Response
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>

                    <div>
                        <div class="panel">
                            <div class="panel-header">
                                <h2>Student Information</h2>
                            </div>
                            <div class="panel-body">
                                <div class="student-card" style="display:flex;align-items:center;gap:14px;padding:18px;background:linear-gradient(135deg,#eef4ff 0%,#f8faff 100%);border-radius:12px;border:1px solid #d9e6f7;">
                                    <div class="student-avatar" style="width:54px;height:54px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:1.2rem;font-weight:750;flex-shrink:0;">
                                        <% var sname = (typeof submission.student_name && !submission.is_anonymous) ? submission.student_name : 'A';
                                        %><%= sname ? sname.charAt(0).toUpperCase() : '?' %>
                                    </div>
                                    <div class="student-info">
                                        <% if (submission.is_anonymous) { %>
                                            <strong style="display:block;font-size:1rem;color:var(--navy-dark);margin-bottom:3px;">Anonymous</strong>
                                            <span style="display:block;font-size:0.82rem;color:var(--gray-500);">Student chose anonymity</span>
                                        <% } else { %>
                                            <strong style="display:block;font-size:1rem;color:var(--navy-dark);margin-bottom:3px;"><%= submission.student_name || 'Unknown' %></strong>
                                            <% if (submission.student_id) { %><span style="display:block;font-size:0.82rem;color:var(--gray-500);">ID: <%= submission.student_id %></span><% } %>
                                        <% } %>
                                    </div>
                                </div>

                                <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--gray-200);">
                                    <div style="margin-bottom:12px;">
                                        <div style="font-size:0.76rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Email</div>
                                        <div style="font-size:0.9rem;color:var(--gray-900);font-weight:500;word-break:break-all;">
                                            <% if (submission.is_anonymous) { %>
                                                <span style="color:var(--gray-500);">••••••••@email.com</span>
                                            <% } else { %>
                                                <%= submission.student_email || '—' %>
                                            <% } %>
                                        </div>
                                    </div>
                                    <% if (!submission.is_anonymous && submission.student_id) { %>
                                        <div>
                                            <div style="font-size:0.76rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px;">Student ID</div>
                                            <div style="font-size:0.9rem;color:var(--gray-900);font-weight:500;"><%= submission.student_id %></div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel-header">
                                <h2>Update Status</h2>
                            </div>
                            <div class="panel-body">
                                <form method="POST" action="/admin/submissions/<%= submission.id %>/status">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <div class="field">
                                        <label for="status">Current status</label>
                                        <select id="status" name="status" required>
                                            <% ['Pending','Under Review','In Progress','Resolved','Rejected'].forEach(function(st) { %>
                                                <option value="<%= st %>" <%= submission.status === st ? 'selected' : '' %>><%= st %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label for="resolution_notes">Resolution notes</label>
                                        <textarea id="resolution_notes" name="resolution_notes" maxlength="3000" rows="4" placeholder="Required when resolving"><%= submission.resolution_notes || '' %></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary" style="width:100%;">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                        Update Status
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel-header"><h2>Update Priority</h2></div>
                            <div class="panel-body">
                                <form method="POST" action="/admin/submissions/<%= submission.id %>/priority">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <div class="field">
                                        <label for="priority">Priority</label>
                                        <select id="priority" name="priority">
                                            <% ['Low','Normal','High','Urgent'].forEach(function(value) { %>
                                                <option value="<%= value %>" <%= (submission.priority || 'Normal') === value ? 'selected' : '' %>><%= value %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-outline" style="width:100%;">Save Priority</button>
                                </form>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel-header">
                                <h2>Assign Staff</h2>
                            </div>
                            <div class="panel-body">
                                <form method="POST" action="/admin/submissions/<%= submission.id %>/assign">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <div class="field">
                                        <label for="department_id">Department queue</label>
                                        <select id="department_id" name="department_id">
                                            <option value="">No department</option>
                                            <% departments.forEach(department => { %>
                                                <option value="<%= department.id %>" <%= submission.department_id == department.id ? 'selected' : '' %>><%= department.name %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label for="assigned_to">Assign to staff member</label>
                                        <select id="assigned_to" name="assigned_to">
                                            <option value="">— Unassigned —</option>
                                            <% if (typeof staffUsers !== 'undefined' && staffUsers && staffUsers.length) { %>
                                                <% staffUsers.forEach(function(staff) { %>
                                                    <option value="<%= staff.id %>" data-department-id="<%= staff.department_id || '' %>" <%= submission.assigned_to == staff.id ? 'selected' : '' %>>
                                                        <%= staff.name %><% if (staff.department_name) { %> — <%= staff.department_name %><% } %>
                                                    </option>
                                                <% }) %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-outline" style="width:100%;">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                                        Assign
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            <% } %>
        </main>

        <footer class="app-footer">
            <p>&copy; <%= new Date().getFullYear() %> EduVoice — Admin Portal</p>
        </footer>
    </div>
</body>
</html>
