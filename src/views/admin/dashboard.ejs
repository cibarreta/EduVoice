<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --navy: #12356a;
            --navy-dark: #0d2850;
            --blue: #2364bd;
            --blue-light: #4f91e8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --violet: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-500: #64748b;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7fb; color: var(--gray-900); margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: var(--navy); color: #fff; flex-shrink: 0; padding: 24px 0; }
        .sidebar-brand { display: flex; align-items: center; gap: 10px; padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand-icon { width: 38px; height: 38px; background: var(--blue); border-radius: 11px; display: grid; place-items: center; }
        .sidebar-brand-icon svg { width: 25px; height: 25px; }
        .sidebar-brand-name { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.04em; }
        .sidebar-menu { margin-top: 20px; padding: 0 12px; list-style: none; }
        .sidebar-menu li { margin: 4px 0; }
        .sidebar-menu a { display: block; padding: 11px 14px; border-radius: 9px; color: #c6d6ee; text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(79,145,232,0.15); color: #fff; }
        .sidebar-menu a.active { background: var(--blue); }
        .main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: #fff; border-bottom: 1px solid var(--gray-200); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar-title { font-size: 1.15rem; font-weight: 700; color: var(--navy-dark); }
        .topbar-user { display: flex; align-items: center; gap: 12px; }
        .topbar-user .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-weight: 700; }
        .topbar-user .user-name { font-weight: 650; font-size: 0.9rem; }
        .topbar-user .user-role { font-size: 0.78rem; color: var(--gray-500); }
        .page-content { padding: 28px 32px; flex: 1; }
        .welcome-header { margin-bottom: 28px; }
        .welcome-header h1 { font-size: 1.8rem; color: var(--navy-dark); letter-spacing: -0.03em; margin-bottom: 6px; }
        .welcome-header p { color: var(--gray-500); font-size: 0.95rem; }
        .welcome-header h1 .accent { color: var(--blue); }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 28px; }
        .stat-card { background: #fff; border-radius: 14px; padding: 22px; border: 1px solid var(--gray-200); box-shadow: 0 2px 10px rgba(15,23,42,0.04); transition: transform 0.15s, box-shadow 0.15s; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,23,42,0.08); }
        .stat-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
        .stat-label { font-size: 0.82rem; color: var(--gray-500); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
        .stat-icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; }
        .stat-icon.navy { background: #e8efff; color: var(--navy); }
        .stat-icon.amber { background: #fff7e6; color: var(--warning); }
        .stat-icon.blue { background: #e8f1ff; color: var(--info); }
        .stat-icon.green { background: #e8f6ee; color: var(--success); }
        .stat-icon.violet { background: #f3efff; color: var(--violet); }
        .stat-icon.red { background: #fdeeee; color: var(--danger); }
        .stat-value { font-size: 2rem; font-weight: 800; color: var(--gray-900); letter-spacing: -0.04em; line-height: 1; }
        .stat-icon svg { width: 22px; height: 22px; }
        .row-2 { margin-top: 18px; }
        .content-grid { display: grid; grid-template-columns: 1fr 380px; gap: 24px; }
        .panel { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); box-shadow: 0 2px 10px rgba(15,23,42,0.04); overflow: hidden; }
        .panel-header { padding: 20px 24px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; }
        .panel-header h2 { font-size: 1.05rem; font-weight: 700; color: var(--navy-dark); }
        .panel-body { padding: 22px 24px; }
        .chart-placeholder { height: 280px; background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%); border-radius: 10px; border: 1px dashed #c7dbf7; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--gray-500); }
        .chart-placeholder .chart-icon { width: 52px; height: 52px; border-radius: 14px; background: #e8f1ff; display: grid; place-items: center; color: var(--blue); margin-bottom: 12px; }
        .chart-placeholder .chart-icon svg { width: 28px; height: 28px; }
        .chart-placeholder p { font-size: 0.9rem; }
        .chart-bars { display: flex; align-items: flex-end; gap: 12px; height: 160px; padding: 0 20px; margin-top: 20px; }
        .chart-bar { flex: 1; background: linear-gradient(180deg, var(--blue-light) 0%, var(--blue) 100%); border-radius: 6px 6px 0 0; min-height: 20px; position: relative; }
        .chart-bar span { position: absolute; top: -22px; left: 50%; transform: translateX(-50%); font-size: 0.72rem; font-weight: 700; color: var(--gray-700); }
        .table { width: 100%; border-collapse: collapse; }
        .table thead th { text-align: left; font-size: 0.78rem; font-weight: 700; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; border-bottom: 2px solid var(--gray-200); }
        .table tbody td { padding: 14px; border-bottom: 1px solid var(--gray-100); font-size: 0.9rem; color: var(--gray-700); }
        .table tbody tr:hover { background: var(--gray-50); }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 650; line-height: 1.3; }
        .badge-amber { background: #fff7e6; color: #b45309; }
        .badge-blue { background: #e8f1ff; color: #1e40af; }
        .badge-violet { background: #f3efff; color: #6d28d9; }
        .badge-green { background: #e8f6ee; color: #15803d; }
        .badge-red { background: #fdeeee; color: #b91c1c; }
        .link-id { font-weight: 600; color: var(--blue); font-family: 'Consolas', monospace; font-size: 0.82rem; }
        .quick-links { display: flex; flex-direction: column; gap: 11px; }
        .quick-link { display: flex; align-items: center; gap: 14px; padding: 15px 16px; border-radius: 11px; background: var(--gray-50); border: 1px solid var(--gray-200); text-decoration: none; color: inherit; transition: all 0.15s; }
        .quick-link:hover { background: #eef4ff; border-color: #c7dbf7; transform: translateX(3px); }
        .quick-link-icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; color: #fff; flex-shrink: 0; }
        .quick-link-icon.b1 { background: var(--blue); }
        .quick-link-icon.b2 { background: var(--violet); }
        .quick-link-icon.b3 { background: var(--navy); }
        .quick-link-icon.b4 { background: var(--success); }
        .quick-link-icon svg { width: 20px; height: 20px; }
        .quick-link-text strong { display: block; color: var(--navy-dark); font-size: 0.92rem; }
        .quick-link-text span { font-size: 0.78rem; color: var(--gray-500); }
        .alert { padding: 13px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
        .alert-success { background: #e8f6ee; color: #15803d; border: 1px solid #bbf7d0; }
        .alert-error { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="sidebar-brand-name">EduVoice</span>
            </div>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard" class="active">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a></li>
                <li><a href="/admin/feedback">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Feedback
                </a></li>
                <li><a href="/admin/suggestions">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Suggestions
                </a></li>
                <li><a href="/admin/users">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Users
                </a></li>
                <li><a href="/admin/statistics">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Statistics
                </a></li>
                <li><a href="/admin/profile">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a></li>
            </ul>
        </aside>
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-title">Dashboard Overview</div>
                <div class="topbar-user">
                    <div style="text-align:right;">
                        <div class="user-name"><%= user ? user.name : 'Admin' %></div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <div class="avatar"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                </div>
            </header>
            <main class="page-content">

                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <div class="welcome-header">
                    <h1>Welcome <span class="accent">Admin</span> 👋</h1>
                    <p>Here's what's happening across EduVoice today.</p>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Total Submissions</span>
                            <div class="stat-icon navy">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            </div>
                        </div>
                        <div class="stat-value"><%= stats ? stats.totalSubmissions : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Pending</span>
                            <div class="stat-icon amber">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                        </div>
                        <div class="stat-value" style="color: var(--warning);"><%= stats ? stats.pending : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">In Progress</span>
                            <div class="stat-icon violet">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            </div>
                        </div>
                        <div class="stat-value" style="color: var(--violet);"><%= stats ? stats.inProgress : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Resolved</span>
                            <div class="stat-icon green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            </div>
                        </div>
                        <div class="stat-value" style="color: var(--success);"><%= stats ? stats.resolved : 0 %></div>
                    </div>
                </div>

                <div class="stats-grid row-2">
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Total Students</span>
                            <div class="stat-icon blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                            </div>
                        </div>
                        <div class="stat-value"><%= stats ? stats.totalStudents : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Total Staff</span>
                            <div class="stat-icon navy">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            </div>
                        </div>
                        <div class="stat-value"><%= stats ? stats.totalStaff : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Total Admins</span>
                            <div class="stat-icon blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            </div>
                        </div>
                        <div class="stat-value"><%= stats ? stats.totalAdmins : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-header">
                            <span class="stat-label">Rejected</span>
                            <div class="stat-icon red">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            </div>
                        </div>
                        <div class="stat-value" style="color: var(--danger);"><%= stats ? stats.rejected : 0 %></div>
                    </div>
                </div>

                <div class="content-grid">
                    <div class="panel">
                        <div class="panel-header">
                            <h2>Submissions Over Time</h2>
                            <span class="stat-label">Last 7 months</span>
                        </div>
                        <div class="panel-body">
                            <% if (typeof chartData !== 'undefined' && chartData && chartData.length) { %>
                                <div class="chart-bars">
                                    <% chartData.forEach(function(item) { %>
                                        <div class="chart-bar" style="height: <%= Math.max(10, (item.count / (chartData.reduce((m,d) => Math.max(m,d.count),1)) * 100)) %>%;">
                                            <span><%= item.count %></span>
                                        </div>
                                    <% }) %>
                                </div>
                                <div style="display:flex;gap:12px;padding: 12px 20px 0;">
                                    <% chartData.forEach(function(item) { %>
                                        <div style="flex:1;text-align:center;font-size:0.75rem;color:var(--gray-500);font-weight:600;"><%= item.label %></div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="chart-placeholder">
                                    <div class="chart-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                    </div>
                                    <p><strong>Chart visualization</strong></p>
                                    <p style="margin-top:4px;">Submissions trend data will appear here</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="panel">
                        <div class="panel-header">
                            <h2>Quick Links</h2>
                        </div>
                        <div class="panel-body">
                            <div class="quick-links">
                                <a href="/admin/feedback" class="quick-link">
                                    <div class="quick-link-icon b1">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                    </div>
                                    <div class="quick-link-text">
                                        <strong>Feedback</strong>
                                        <span>Review student feedback</span>
                                    </div>
                                </a>
                                <a href="/admin/suggestions" class="quick-link">
                                    <div class="quick-link-icon b2">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                                    </div>
                                    <div class="quick-link-text">
                                        <strong>Suggestions</strong>
                                        <span>Browse student ideas</span>
                                    </div>
                                </a>
                                <a href="/admin/users" class="quick-link">
                                    <div class="quick-link-icon b3">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    </div>
                                    <div class="quick-link-text">
                                        <strong>Users</strong>
                                        <span>Manage accounts & roles</span>
                                    </div>
                                </a>
                                <a href="/admin/statistics" class="quick-link">
                                    <div class="quick-link-icon b4">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                    </div>
                                    <div class="quick-link-text">
                                        <strong>Statistics</strong>
                                        <span>Reports & analytics</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel" style="margin-top:24px;">
                    <div class="panel-header">
                        <h2>Recent Submissions</h2>
                        <a href="/admin/feedback" style="font-size:0.85rem;font-weight:650;color:var(--blue);text-decoration:none;">View all →</a>
                    </div>
                    <div style="overflow-x:auto;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Student</th>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof recentSubmissions !== 'undefined' && recentSubmissions && recentSubmissions.length) { %>
                                    <% recentSubmissions.forEach(function(sub) { %>
                                        <tr>
                                            <td><span class="link-id">#<%= sub.id %></span></td>
                                            <td><%= sub.student_name || 'Anonymous' %></td>
                                            <td style="max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500;"><%= sub.title %></td>
                                            <td>
                                                <% if (sub.type === 'suggestion') { %>
                                                    <span class="badge badge-violet">Suggestion</span>
                                                <% } else { %>
                                                    <span class="badge badge-blue">Feedback</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (sub.status === 'Pending') { %>
                                                    <span class="badge badge-amber">Pending</span>
                                                <% } else if (sub.status === 'Under Review') { %>
                                                    <span class="badge badge-blue">Under Review</span>
                                                <% } else if (sub.status === 'In Progress') { %>
                                                    <span class="badge badge-violet">In Progress</span>
                                                <% } else if (sub.status === 'Resolved') { %>
                                                    <span class="badge badge-green">Resolved</span>
                                                <% } else if (sub.status === 'Rejected') { %>
                                                    <span class="badge badge-red">Rejected</span>
                                                <% } else { %>
                                                    <span class="badge badge-blue"><%= sub.status %></span>
                                                <% } %>
                                            </td>
                                            <td><%= new Date(sub.created_at).toLocaleDateString() %></td>
                                            <td>
                                                <a href="/admin/submissions/<%= sub.id %>" style="display:inline-block;padding:6px 13px;border-radius:7px;background:var(--gray-100);color:var(--navy-dark);font-size:0.82rem;font-weight:650;text-decoration:none;">View</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--gray-500);">No recent submissions yet.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>
</body>
</html>
