<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statistics & Reports | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --navy: #12356a;
            --navy-dark: #0d2850;
            --blue: #2364bd;
            --blue-light: #4f91e8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --violet: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-500: #64748b;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7fb; color: var(--gray-900); margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: var(--navy); color: #fff; flex-shrink: 0; padding: 24px 0; }
        .sidebar-brand { display: flex; align-items: center; gap: 10px; padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand-icon { width: 38px; height: 38px; background: var(--blue); border-radius: 11px; display: grid; place-items: center; }
        .sidebar-brand-icon svg { width: 25px; height: 25px; color: #fff; }
        .sidebar-brand-name { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.04em; }
        .sidebar-menu { margin-top: 20px; padding: 0 12px; list-style: none; }
        .sidebar-menu li { margin: 4px 0; }
        .sidebar-menu a { display: block; padding: 11px 14px; border-radius: 9px; color: #c6d6ee; text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(79,145,232,0.15); color: #fff; }
        .sidebar-menu a.active { background: var(--success); }
        .main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: #fff; border-bottom: 1px solid var(--gray-200); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar-title { font-size: 1.15rem; font-weight: 700; color: var(--navy-dark); }
        .topbar-user { display: flex; align-items: center; gap: 12px; }
        .topbar-user .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--success); color: #fff; display: grid; place-items: center; font-weight: 700; }
        .topbar-user .user-name { font-weight: 650; font-size: 0.9rem; }
        .topbar-user .user-role { font-size: 0.78rem; color: var(--gray-500); }
        .page-content { padding: 28px 32px; flex: 1; }
        .page-header { margin-bottom: 26px; }
        .page-header h1 { font-size: 1.75rem; color: var(--navy-dark); letter-spacing: -0.03em; margin-bottom: 4px; }
        .page-header p { color: var(--gray-500); font-size: 0.93rem; }
        .alert { padding: 13px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
        .alert-success { background: #e8f6ee; color: #15803d; border: 1px solid #bbf7d0; }
        .alert-error { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
        .panel { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); margin-bottom: 22px; box-shadow: 0 2px 10px rgba(15,23,42,0.04); overflow: hidden; }
        .panel-header { padding: 18px 22px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .panel-header h2 { font-size: 1rem; font-weight: 700; color: var(--navy-dark); }
        .panel-header .label-kicker { font-size: 0.75rem; color: var(--gray-500); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
        .panel-body { padding: 22px; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 22px; }
        .stat-card { background: #fff; border-radius: 14px; padding: 22px; border: 1px solid var(--gray-200); box-shadow: 0 2px 10px rgba(15,23,42,0.04); position: relative; overflow: hidden; }
        .stat-card::after { content:''; position:absolute; right:-20px; top:-20px; width:90px; height:90px; border-radius:50%; opacity:0.08; }
        .stat-card.c-navy::after { background: var(--navy); }
        .stat-card.c-violet::after { background: var(--violet); }
        .stat-card.c-green::after { background: var(--success); }
        .stat-card.c-blue::after { background: var(--blue); }
        .stat-label { font-size: 0.8rem; color: var(--gray-500); font-weight: 650; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; }
        .stat-value { font-size: 2.15rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: var(--gray-900); margin-bottom: 8px; }
        .stat-sub { font-size: 0.78rem; color: var(--gray-500); }
        .stat-icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; margin-bottom: 14px; color: #fff; }
        .stat-icon.navy { background: var(--navy); }
        .stat-icon.violet { background: var(--violet); }
        .stat-icon.green { background: var(--success); }
        .stat-icon.blue { background: var(--blue); }
        .stat-icon svg { width: 22px; height: 22px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 22px; }
        .ratio-bar-card { padding: 8px 0; }
        .ratio-row { margin-bottom: 18px; }
        .ratio-row:last-child { margin-bottom: 0; }
        .ratio-head { display: flex; justify-content: space-between; margin-bottom: 8px; align-items: center; }
        .ratio-head strong { font-size: 0.9rem; color: var(--gray-700); display: inline-flex; align-items: center; gap: 8px; }
        .ratio-head .dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
        .ratio-head .count { font-size: 0.8rem; color: var(--gray-500); font-weight: 600; }
        .ratio-bar { height: 10px; background: var(--gray-100); border-radius: 999px; overflow: hidden; }
        .ratio-fill { height: 100%; border-radius: 999px; transition: width 0.5s; }
        .status-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
        .status-card { padding: 16px 14px; border-radius: 12px; text-align: center; border: 1px solid var(--gray-200); background: var(--gray-50); transition: all 0.15s; }
        .status-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(15,23,42,0.08); }
        .status-card.amber { background: #fff7e6; border-color: #fde68a; }
        .status-card.blue { background: #e8f1ff; border-color: #bfdbfe; }
        .status-card.violet { background: #f3efff; border-color: #ddd6fe; }
        .status-card.green { background: #e8f6ee; border-color: #bbf7d0; }
        .status-card.red { background: #fdeeee; border-color: #fecaca; }
        .status-card-num { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin-bottom: 6px; }
        .status-card.amber .status-card-num { color: #b45309; }
        .status-card.blue .status-card-num { color: #1e40af; }
        .status-card.violet .status-card-num { color: #6d28d9; }
        .status-card.green .status-card-num { color: #15803d; }
        .status-card.red .status-card-num { color: #b91c1c; }
        .status-card-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gray-700); }
        .cat-list { display: flex; flex-direction: column; gap: 12px; }
        .cat-row { display: grid; grid-template-columns: 140px 1fr 70px; gap: 14px; align-items: center; }
        .cat-name { font-size: 0.88rem; color: var(--gray-700); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cat-bar { height: 10px; background: var(--gray-100); border-radius: 999px; overflow: hidden; }
        .cat-bar-fill { height: 100%; background: linear-gradient(90deg, var(--blue) 0%, var(--blue-light) 100%); border-radius: 999px; }
        .cat-count { font-size: 0.85rem; font-weight: 700; color: var(--navy); text-align: right; font-family: 'Consolas', monospace; }
        .table-wrap { overflow-x: auto; }
        .table { width: 100%; border-collapse: collapse; }
        .table thead th { text-align: left; font-size: 0.78rem; font-weight: 700; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 16px; border-bottom: 2px solid var(--gray-200); background: var(--gray-50); }
        .table thead th.num { text-align: right; }
        .table tbody td { padding: 14px 16px; border-bottom: 1px solid var(--gray-100); font-size: 0.9rem; color: var(--gray-700); }
        .table tbody td.num { text-align: right; font-family: 'Consolas', monospace; font-weight: 600; color: var(--navy-dark); }
        .table tbody tr:hover { background: var(--gray-50); }
        .table tbody tr:last-child td { border-bottom: none; }
        .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; line-height: 1.3; }
        .pill-navy { background: #e8efff; color: var(--navy); }
        .mini-trend { display: inline-flex; align-items: center; gap: 4px; font-size: 0.74rem; font-weight: 700; margin-left: 8px; padding: 2px 7px; border-radius: 999px; }
        .mini-trend.up { background: #e8f6ee; color: #15803d; }
        .mini-trend.down { background: #fdeeee; color: #b91c1c; }
        .resolution-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
        .res-card { padding: 18px; border-radius: 12px; background: var(--gray-50); border: 1px solid var(--gray-200); text-align: center; }
        .res-card h4 { font-size: 0.76rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; font-weight: 700; }
        .res-card .big { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; color: var(--navy-dark); }
        .res-card .desc { font-size: 0.78rem; color: var(--gray-500); margin-top: 4px; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="sidebar-brand-name">EduVoice</span>
            </div>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a></li>
                <li><a href="/admin/feedback">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Feedback
                </a></li>
                <li><a href="/admin/suggestions">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Suggestions
                </a></li>
                <li><a href="/admin/users">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Users
                </a></li>
                <li><a href="/admin/statistics" class="active">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Statistics
                </a></li>
                <li><a href="/admin/profile">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a></li>
            </ul>
        </aside>
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-title">Statistics & Reports</div>
                <div class="topbar-user">
                    <div style="text-align:right;">
                        <div class="user-name"><%= user ? user.name : 'Admin' %></div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <div class="avatar"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                </div>
            </header>
            <main class="page-content">

                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <div class="page-header">
                    <h1>Statistics Dashboard</h1>
                    <p>Insights and reports on submissions, categories, and performance.</p>
                </div>

                <div class="stats-grid">
                    <div class="stat-card c-navy">
                        <div class="stat-icon navy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        </div>
                        <div class="stat-label">Total Submissions</div>
                        <div class="stat-value"><%= typeof totalSubmissions !== 'undefined' ? totalSubmissions : 0 %></div>
                        <div class="stat-sub">All feedback + suggestions</div>
                    </div>
                    <div class="stat-card c-violet">
                        <div class="stat-icon violet">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <div class="stat-label">Feedback</div>
                        <div class="stat-value" style="color:var(--violet);"><%= typeof feedbackCount !== 'undefined' ? feedbackCount : 0 %></div>
                        <div class="stat-sub"><%= typeof totalSubmissions !== 'undefined' && totalSubmissions ? Math.round((feedbackCount || 0) / totalSubmissions * 100) : 0 %>% of total</div>
                    </div>
                    <div class="stat-card c-blue">
                        <div class="stat-icon blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        </div>
                        <div class="stat-label">Suggestions</div>
                        <div class="stat-value" style="color:var(--blue);"><%= typeof suggestionsCount !== 'undefined' ? suggestionsCount : 0 %></div>
                        <div class="stat-sub"><%= typeof totalSubmissions !== 'undefined' && totalSubmissions ? Math.round((suggestionsCount || 0) / totalSubmissions * 100) : 0 %>% of total</div>
                    </div>
                    <div class="stat-card c-green">
                        <div class="stat-icon green">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <div class="stat-label">Resolution Rate</div>
                        <div class="stat-value" style="color:var(--success);"><%= typeof totalSubmissions !== 'undefined' && totalSubmissions ? Math.round(((resolvedCount || 0) / totalSubmissions) * 100) : 0 %>%</div>
                        <div class="stat-sub"><%= typeof resolvedCount !== 'undefined' ? resolvedCount : 0 %> resolved</div>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="panel">
                        <div class="panel-header">
                            <h2>Feedback vs Suggestions Ratio</h2>
                            <span class="label-kicker">Breakdown</span>
                        </div>
                        <div class="panel-body">
                            <div class="ratio-bar-card">
                                <%
                                    var fb = typeof feedbackCount !== 'undefined' ? feedbackCount : 0;
                                    var sg = typeof suggestionsCount !== 'undefined' ? suggestionsCount : 0;
                                    var rt = fb + sg || 1;
                                    var fbPct = Math.round(fb / rt * 100);
                                    var sgPct = Math.round(sg / rt * 100);
                                %>
                                <div class="ratio-row">
                                    <div class="ratio-head">
                                        <strong><span class="dot" style="background:var(--blue);"></span>Feedback</strong>
                                        <span class="count"><%= fb %> submissions · <%= fbPct %>%</span>
                                    </div>
                                    <div class="ratio-bar">
                                        <div class="ratio-fill" style="width:<%= fbPct %>%;background:linear-gradient(90deg,var(--blue) 0%,var(--blue-light) 100%);"></div>
                                    </div>
                                </div>
                                <div class="ratio-row">
                                    <div class="ratio-head">
                                        <strong><span class="dot" style="background:var(--violet);"></span>Suggestions</strong>
                                        <span class="count"><%= sg %> submissions · <%= sgPct %>%</span>
                                    </div>
                                    <div class="ratio-bar">
                                        <div class="ratio-fill" style="width:<%= sgPct %>%;background:linear-gradient(90deg,var(--violet) 0%,#a78bfa 100%);"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header">
                            <h2>Resolution Summary</h2>
                            <span class="label-kicker">Overview</span>
                        </div>
                        <div class="panel-body">
                            <div class="resolution-grid">
                                <div class="res-card">
                                    <h4>Resolved</h4>
                                    <div class="big" style="color:var(--success);"><%= typeof resolvedCount !== 'undefined' ? resolvedCount : 0 %></div>
                                    <div class="desc">Closed & complete</div>
                                </div>
                                <div class="res-card">
                                    <h4>In Progress</h4>
                                    <div class="big" style="color:var(--warning);"><%= typeof inProgressCount !== 'undefined' ? inProgressCount : 0 %></div>
                                    <div class="desc">Active handling</div>
                                </div>
                                <div class="res-card">
                                    <h4>Avg Time</h4>
                                    <div class="big" style="color:var(--navy);"><%= typeof avgResolutionDays !== 'undefined' ? avgResolutionDays : 0 %>d</div>
                                    <div class="desc">to close tickets</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel" style="margin-bottom:22px;">
                    <div class="panel-header">
                        <h2>Status Distribution</h2>
                        <span class="label-kicker">Current state of submissions</span>
                    </div>
                    <div class="panel-body">
                        <%
                            var s_pending = typeof pendingCount !== 'undefined' ? pendingCount : 0;
                            var s_review = typeof underReviewCount !== 'undefined' ? underReviewCount : 0;
                            var s_progress = typeof inProgressCount !== 'undefined' ? inProgressCount : 0;
                            var s_resolved = typeof resolvedCount !== 'undefined' ? resolvedCount : 0;
                            var s_rejected = typeof rejectedCount !== 'undefined' ? rejectedCount : 0;
                        %>
                        <div class="status-cards">
                            <div class="status-card amber">
                                <div class="status-card-num"><%= s_pending %></div>
                                <div class="status-card-label">Pending</div>
                            </div>
                            <div class="status-card blue">
                                <div class="status-card-num"><%= s_review %></div>
                                <div class="status-card-label">Under Review</div>
                            </div>
                            <div class="status-card violet">
                                <div class="status-card-num"><%= s_progress %></div>
                                <div class="status-card-label">In Progress</div>
                            </div>
                            <div class="status-card green">
                                <div class="status-card-num"><%= s_resolved %></div>
                                <div class="status-card-label">Resolved</div>
                            </div>
                            <div class="status-card red">
                                <div class="status-card-num"><%= s_rejected %></div>
                                <div class="status-card-label">Rejected</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="panel">
                        <div class="panel-header">
                            <h2>Categories Breakdown</h2>
                            <span class="label-kicker">Submissions per category</span>
                        </div>
                        <div class="panel-body">
                            <div class="cat-list">
                                <%
                                    var catStatsExists = typeof categoryStats !== 'undefined' && categoryStats && categoryStats.length;
                                    var catMax = 1;
                                    if (catStatsExists) {
                                        categoryStats.forEach(function(c) { if (c.count > catMax) catMax = c.count; });
                                    }
                                %>
                                <% if (catStatsExists) { %>
                                    <% categoryStats.forEach(function(c) {
                                        var pct = Math.round(c.count / catMax * 100);
                                    %>
                                        <div class="cat-row">
                                            <div class="cat-name"><%= c.name %></div>
                                            <div class="cat-bar">
                                                <div class="cat-bar-fill" style="width:<%= pct %>%;"></div>
                                            </div>
                                            <div class="cat-count"><%= c.count %></div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div style="padding:30px 10px;text-align:center;color:var(--gray-500);font-size:0.9rem;">
                                        No category data available yet.
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header">
                            <h2>Monthly Trends</h2>
                            <span class="label-kicker">Last 6 months</span>
                        </div>
                        <div class="panel-body">
                            <div class="table-wrap">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Month</th>
                                            <th class="num">Feedback</th>
                                            <th class="num">Suggestions</th>
                                            <th class="num">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <%
                                            var mdExists = typeof monthlyData !== 'undefined' && monthlyData && monthlyData.length;
                                        %>
                                        <% if (mdExists) { %>
                                            <% monthlyData.forEach(function(m) {
                                                var t = (m.feedback || 0) + (m.suggestions || 0);
                                            %>
                                                <tr>
                                                    <td style="font-weight:600;color:var(--navy-dark);"><%= m.label %></td>
                                                    <td class="num"><%= m.feedback || 0 %></td>
                                                    <td class="num"><%= m.suggestions || 0 %></td>
                                                    <td class="num">
                                                        <span class="pill pill-navy"><%= t %></span>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" style="text-align:center;padding:30px;color:var(--gray-500);">No monthly data available yet.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>
</body>
</html>
