<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --navy: #12356a;
            --navy-dark: #0d2850;
            --blue: #2364bd;
            --blue-light: #4f91e8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --violet: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-500: #64748b;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7fb; color: var(--gray-900); margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: var(--navy); color: #fff; flex-shrink: 0; padding: 24px 0; }
        .sidebar-brand { display: flex; align-items: center; gap: 10px; padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand-icon { width: 38px; height: 38px; background: var(--blue); border-radius: 11px; display: grid; place-items: center; }
        .sidebar-brand-icon svg { width: 25px; height: 25px; color: #fff; }
        .sidebar-brand-name { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.04em; }
        .sidebar-menu { margin-top: 20px; padding: 0 12px; list-style: none; }
        .sidebar-menu li { margin: 4px 0; }
        .sidebar-menu a { display: block; padding: 11px 14px; border-radius: 9px; color: #c6d6ee; text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(79,145,232,0.15); color: #fff; }
        .sidebar-menu a.active { background: var(--blue); }
        .main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: #fff; border-bottom: 1px solid var(--gray-200); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar-title { font-size: 1.15rem; font-weight: 700; color: var(--navy-dark); }
        .topbar-user { display: flex; align-items: center; gap: 12px; }
        .topbar-user .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-weight: 700; }
        .topbar-user .user-name { font-weight: 650; font-size: 0.9rem; }
        .topbar-user .user-role { font-size: 0.78rem; color: var(--gray-500); }
        .page-content { padding: 28px 32px; flex: 1; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: var(--blue); font-weight: 600; text-decoration: none; margin-bottom: 16px; }
        .alert { padding: 13px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
        .alert-success { background: #e8f6ee; color: #15803d; border: 1px solid #bbf7d0; }
        .alert-error { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
        .content-grid { display: grid; grid-template-columns: 340px 1fr; gap: 24px; align-items: start; }
        .panel { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); margin-bottom: 22px; box-shadow: 0 2px 10px rgba(15,23,42,0.04); overflow: hidden; }
        .panel-header { padding: 18px 22px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .panel-header h2 { font-size: 1rem; font-weight: 700; color: var(--navy-dark); }
        .panel-body { padding: 22px; }
        .profile-card { padding: 28px 22px; text-align: center; background: linear-gradient(180deg, #eef4ff 0%, #ffffff 60%); }
        .profile-avatar { width: 84px; height: 84px; border-radius: 50%; margin: 0 auto 16px; display: grid; place-items: center; color: #fff; font-size: 2.05rem; font-weight: 750; letter-spacing: -0.03em; box-shadow: 0 8px 24px rgba(18,53,106,0.15); }
        .profile-card h2 { font-size: 1.2rem; color: var(--navy-dark); margin-bottom: 5px; letter-spacing: -0.02em; }
        .profile-email { font-size: 0.85rem; color: var(--gray-500); margin-bottom: 18px; word-break: break-all; }
        .profile-tags { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
        .badge { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 650; line-height: 1.3; }
        .badge-navy { background: #e8efff; color: var(--navy); }
        .badge-violet { background: #f3efff; color: #6d28d9; }
        .badge-green { background: #e8f6ee; color: #15803d; }
        .badge-green-soft { background: #eafaf6; color: #166534; }
        .badge-red-soft { background: #fdeeee; color: #b91c1c; }
        .status-dot { display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;vertical-align:middle; }
        .info-list { list-style: none; display: flex; flex-direction: column; }
        .info-list li { padding: 13px 0; border-bottom: 1px solid var(--gray-100); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .info-list li:last-child { border-bottom: none; }
        .info-label { font-size: 0.8rem; color: var(--gray-500); font-weight: 600; }
        .info-value { font-size: 0.9rem; color: var(--gray-900); font-weight: 500; text-align: right; word-break: break-all; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
        .stat-mini { background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: 12px; padding: 16px; text-align: center; }
        .stat-mini-val { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; color: var(--navy-dark); line-height: 1; margin-bottom: 6px; }
        .stat-mini-val.a { color: var(--blue); }
        .stat-mini-val.b { color: var(--warning); }
        .stat-mini-val.c { color: var(--success); }
        .stat-mini-val.d { color: var(--danger); }
        .stat-mini-label { font-size: 0.72rem; color: var(--gray-500); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
        .field { margin-bottom: 14px; }
        .field:last-child { margin-bottom: 0; }
        .field label { display: block; font-size: 0.82rem; font-weight: 700; color: var(--gray-700); margin-bottom: 7px; }
        .field select { width: 100%; padding: 10px 12px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.9rem; color: var(--gray-900); background: #fff; font-family: inherit; transition: border 0.15s, box-shadow 0.15s; }
        .field select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(79,145,232,0.18); }
        .btn { padding: 10px 16px; border-radius: 8px; font-size: 0.86rem; font-weight: 650; font-family: inherit; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 7px; transition: all 0.15s; }
        .btn-primary { background: var(--navy); color: #fff; }
        .btn-primary:hover { background: var(--navy-dark); }
        .btn-warn { background: #fff7e6; color: #b45309; border: 1px solid #fde68a; }
        .btn-warn:hover { background: #fde68a; }
        .btn-danger { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
        .btn-danger:hover { background: #fecaca; }
        .btn-block { width: 100%; }
        .submissions-list { display: flex; flex-direction: column; gap: 10px; }
        .sub-item { padding: 14px 16px; border-radius: 11px; border: 1px solid var(--gray-200); background: var(--gray-50); display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; transition: all 0.15s; }
        .sub-item:hover { background: #fff; border-color: var(--blue-light); }
        .sub-info strong { display: block; font-size: 0.9rem; color: var(--navy-dark); margin-bottom: 5px; }
        .sub-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .sub-meta span { font-size: 0.75rem; color: var(--gray-500); display: inline-flex; align-items: center; gap: 5px; }
        .sub-meta .cat { background: #fff; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--gray-200); color: var(--gray-700); font-weight: 600; }
        .btn-sm { padding: 6px 12px; border-radius: 7px; font-size: 0.8rem; font-weight: 600; background: var(--navy); color: #fff; text-decoration: none; display: inline-block; }
        .btn-sm:hover { background: var(--navy-dark); }
        .badge-amber { background: #fff7e6; color: #b45309; }
        .badge-blue { background: #e8f1ff; color: #1e40af; }
        .empty-state { padding: 40px 20px; text-align: center; }
        .empty-state .empty-icon { width: 56px; height: 56px; margin: 0 auto 12px; border-radius: 16px; background: var(--gray-100); display: grid; place-items: center; color: var(--gray-500); }
        .empty-state .empty-icon svg { width: 28px; height: 28px; }
        .empty-state h4 { font-size: 0.98rem; color: var(--navy-dark); margin-bottom: 5px; }
        .empty-state p { color: var(--gray-500); font-size: 0.86rem; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="sidebar-brand-name">EduVoice</span>
            </div>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a></li>
                <li><a href="/admin/feedback">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Feedback
                </a></li>
                <li><a href="/admin/suggestions">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Suggestions
                </a></li>
                <li><a href="/admin/users" class="active">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Users
                </a></li>
                <li><a href="/admin/statistics">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Statistics
                </a></li>
                <li><a href="/admin/profile">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a></li>
            </ul>
        </aside>
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-title">User Details</div>
                <div class="topbar-user">
                    <div style="text-align:right;">
                        <div class="user-name"><%= user ? user.name : 'Admin' %></div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <div class="avatar"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                </div>
            </header>
            <main class="page-content">

                <a href="/admin/users" class="back-link">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Back to users
                </a>

                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <% if (typeof userDetail !== 'undefined' && userDetail) { %>
                    <%
                        var bgColors = { admin: 'var(--violet)', staff: 'var(--blue)', student: 'var(--navy)' };
                        var avatarColor = bgColors[userDetail.role] || 'var(--navy)';
                        var initial = userDetail.name ? userDetail.name.charAt(0).toUpperCase() : '?';
                    %>

                    <div class="content-grid">
                        <div>
                            <div class="panel">
                                <div class="profile-card">
                                    <div class="profile-avatar" style="background:<%= avatarColor %>;"><%= initial %></div>
                                    <h2><%= userDetail.name || 'Unnamed User' %></h2>
                                    <div class="profile-email"><%= userDetail.email || 'No email' %></div>
                                    <div class="profile-tags">
                                        <% if (userDetail.role === 'admin') { %>
                                            <span class="badge badge-violet">Admin</span>
                                        <% } else if (userDetail.role === 'staff') { %>
                                            <span class="badge badge-navy">Staff</span>
                                        <% } else { %>
                                            <span class="badge badge-green">Student</span>
                                        <% } %>
                                        <% if (typeof userDetail.is_active === false || userDetail.is_active === 0) { %>
                                            <span class="badge badge-red-soft"><span class="status-dot" style="background:#dc2626;"></span>Inactive</span>
                                        <% } else { %>
                                            <span class="badge badge-green-soft"><span class="status-dot" style="background:#16a34a;"></span>Active</span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="panel-body" style="padding-top:0;padding-bottom:16px;">
                                    <ul class="info-list">
                                        <li>
                                            <span class="info-label">Account Created</span>
                                            <span class="info-value"><%= userDetail.created_at ? new Date(userDetail.created_at).toLocaleDateString() : '—' %></span>
                                        </li>
                                        <% if (userDetail.student_id) { %>
                                            <li>
                                                <span class="info-label">Student ID</span>
                                                <span class="info-value" style="font-family:'Consolas',monospace;"><%= userDetail.student_id %></span>
                                            </li>
                                        <% } %>
                                        <% if (typeof userDetail.last_login !== 'undefined' && userDetail.last_login) { %>
                                            <li>
                                                <span class="info-label">Last Login</span>
                                                <span class="info-value"><%= new Date(userDetail.last_login).toLocaleString() %></span>
                                            </li>
                                        <% } %>
                                    </ul>
                                </div>
                            </div>

                            <% if (typeof user !== 'undefined' && user && user.id != userDetail.id) { %>
                                <div class="panel">
                                    <div class="panel-header">
                                        <h2>Manage Account</h2>
                                    </div>
                                    <div class="panel-body">
                                        <form method="POST" action="/admin/users/<%= userDetail.id %>/role">
                                            <div class="field">
                                                <label for="role">Change Role</label>
                                                <select id="role" name="role">
                                                    <option value="student" <%= userDetail.role === 'student' ? 'selected' : '' %>>Student</option>
                                                    <option value="staff" <%= userDetail.role === 'staff' ? 'selected' : '' %>>Staff</option>
                                                    <option value="admin" <%= userDetail.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                                </select>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-block">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/></svg>
                                                Update Role
                                            </button>
                                        </form>

                                        <div style="height:1px;background:var(--gray-200);margin:18px 0;"></div>

                                        <form method="POST" action="/admin/users/<%= userDetail.id %>/toggle" onsubmit="return confirm('Toggle account status?');" style="margin-bottom:10px;">
                                            <% if (typeof userDetail.is_active === false || userDetail.is_active === 0) { %>
                                                <button type="submit" class="btn btn-warn btn-block">
                                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                                    Activate Account
                                                </button>
                                            <% } else { %>
                                                <button type="submit" class="btn btn-danger btn-block">
                                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                                    Deactivate Account
                                                </button>
                                            <% } %>
                                        </form>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <div>
                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Submission Statistics</h2>
                                </div>
                                <div class="panel-body">
                                    <div class="stats-grid">
                                        <div class="stat-mini">
                                            <div class="stat-mini-val a"><%= userStats ? userStats.total : 0 %></div>
                                            <div class="stat-mini-label">Total</div>
                                        </div>
                                        <div class="stat-mini">
                                            <div class="stat-mini-val b"><%= userStats ? userStats.pending : 0 %></div>
                                            <div class="stat-mini-label">Pending</div>
                                        </div>
                                        <div class="stat-mini">
                                            <div class="stat-mini-val c"><%= userStats ? userStats.resolved : 0 %></div>
                                            <div class="stat-mini-label">Resolved</div>
                                        </div>
                                        <div class="stat-mini">
                                            <div class="stat-mini-val d"><%= userStats ? userStats.rejected : 0 %></div>
                                            <div class="stat-mini-label">Rejected</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Recent Submissions</h2>
                                    <% if (typeof userSubmissions !== 'undefined' && userSubmissions && userSubmissions.length) { %>
                                        <a href="/admin/<%= userDetail.role === 'student' ? 'feedback' : 'feedback' %>" style="font-size:0.82rem;font-weight:650;color:var(--blue);text-decoration:none;">View all →</a>
                                    <% } %>
                                </div>
                                <div class="panel-body">
                                    <% if (typeof userSubmissions !== 'undefined' && userSubmissions && userSubmissions.length) { %>
                                        <div class="submissions-list">
                                            <% userSubmissions.forEach(function(sub) { %>
                                                <div class="sub-item">
                                                    <div class="sub-info" style="flex:1;min-width:0;">
                                                        <strong><%= sub.title %></strong>
                                                        <div class="sub-meta">
                                                            <% if (sub.category_name) { %>
                                                                <span class="cat"><%= sub.category_name %></span>
                                                            <% } %>
                                                            <% if (sub.status === 'Pending') { %>
                                                                <span class="badge badge-amber">Pending</span>
                                                            <% } else if (sub.status === 'Under Review') { %>
                                                                <span class="badge badge-blue">Under Review</span>
                                                            <% } else if (sub.status === 'In Progress') { %>
                                                                <span class="badge badge-violet">In Progress</span>
                                                            <% } else if (sub.status === 'Resolved') { %>
                                                                <span class="badge badge-green">Resolved</span>
                                                            <% } else if (sub.status === 'Rejected') { %>
                                                                <span class="badge badge-red-soft">Rejected</span>
                                                            <% } else { %>
                                                                <span class="badge badge-blue"><%= sub.status %></span>
                                                            <% } %>
                                                            <span><%= sub.created_at ? new Date(sub.created_at).toLocaleDateString() : '—' %></span>
                                                        </div>
                                                    </div>
                                                    <a href="/admin/submissions/<%= sub.id %>" class="btn-sm">View</a>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <div class="empty-state">
                                            <div class="empty-icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                            </div>
                                            <h4>No submissions yet</h4>
                                            <p>This user hasn't made any submissions.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                <% } %>

            </main>
        </div>
    </div>
</body>
</html>
