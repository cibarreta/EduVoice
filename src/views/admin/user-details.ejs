<!DOCTYPE html>
<html lang="en">
<head>
    <% var title = "User Details"; %>
    <%- include("../partials/head") %>
</head>
<body class="app-shell">
    <%- include("../partials/sidebar", { user: user, currentPath: "/admin/users", role: "admin" }) %>

    <div class="app-main-wrap">
        <header class="app-topbar">
            <button class="topbar-menu-btn" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-sidebar" data-sidebar-open>
                <span></span><span></span><span></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-user-avatar" aria-hidden="true">
                    <%= (typeof user !== 'undefined' && user && user.name ? user.name.charAt(0).toUpperCase() : 'A') %>
                </div>
                <div class="topbar-user-meta">
                    <strong><%= (typeof user !== 'undefined' && user ? user.name : 'Admin') %></strong>
                    <span>Admin</span>
                </div>
            </div>
        </header>

        <div class="app-alerts">
            <%- include("../partials/alerts") %>
        </div>

        <main class="app-content">
            <a href="/admin/users" class="back-link">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to users
            </a>

            <% if (typeof userDetail !== 'undefined' && userDetail) { %>
                <%
                    var bgColors = { admin: 'var(--violet)', staff: 'var(--blue)', student: 'var(--navy)' };
                    var avatarColor = bgColors[userDetail.role] || 'var(--navy)';
                    var initial = userDetail.name ? userDetail.name.charAt(0).toUpperCase() : '?';
                %>

                <div class="content-grid">
                    <div>
                        <div class="panel">
                            <div class="profile-card" style="padding:28px 22px;text-align:center;background:linear-gradient(180deg,#eef4ff 0%,#ffffff 60%);">
                                <div class="profile-avatar" style="width:84px;height:84px;border-radius:50%;margin:0 auto 16px;display:grid;place-items:center;color:#fff;font-size:2.05rem;font-weight:750;letter-spacing:-0.03em;box-shadow:0 8px 24px rgba(18,53,106,0.15);background:<%= avatarColor %>;"><%= initial %></div>
                                <h2 style="font-size:1.2rem;color:var(--navy-dark);margin-bottom:5px;letter-spacing:-0.02em;"><%= userDetail.name || 'Unnamed User' %></h2>
                                <div class="profile-email" style="font-size:0.85rem;color:var(--gray-500);margin-bottom:18px;word-break:break-all;"><%= userDetail.email || 'No email' %></div>
                                <div class="profile-tags" style="display:flex;justify-content:center;gap:8px;flex-wrap:wrap;">
                                    <% if (userDetail.role === 'admin') { %>
                                        <span class="role-badge role-admin">Admin</span>
                                    <% } else if (userDetail.role === 'staff') { %>
                                        <span class="role-badge role-staff">Staff</span>
                                    <% } else { %>
                                        <span class="role-badge role-student">Student</span>
                                    <% } %>
                                    <% if (typeof userDetail.is_active === false || userDetail.is_active === 0) { %>
                                        <span class="badge-user-inactive">Inactive</span>
                                    <% } else { %>
                                        <span class="badge-user-active">Active</span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="panel-body" style="padding-top:0;padding-bottom:16px;">
                                <ul class="info-list" style="list-style:none;display:flex;flex-direction:column;">
                                    <li style="padding:13px 0;border-bottom:1px solid var(--gray-100);display:flex;align-items:center;justify-content:space-between;gap:12px;">
                                        <span class="info-label" style="font-size:0.8rem;color:var(--gray-500);font-weight:600;">Account Created</span>
                                        <span class="info-value" style="font-size:0.9rem;color:var(--gray-900);font-weight:500;text-align:right;word-break:break-all;"><%= userDetail.created_at ? new Date(userDetail.created_at).toLocaleDateString() : '—' %></span>
                                    </li>
                                    <% if (userDetail.student_id) { %>
                                        <li style="padding:13px 0;border-bottom:1px solid var(--gray-100);display:flex;align-items:center;justify-content:space-between;gap:12px;">
                                            <span class="info-label" style="font-size:0.8rem;color:var(--gray-500);font-weight:600;">Student ID</span>
                                            <span class="info-value" style="font-family:'Consolas',monospace;font-size:0.9rem;color:var(--gray-900);font-weight:500;text-align:right;word-break:break-all;"><%= userDetail.student_id %></span>
                                        </li>
                                    <% } %>
                                    <% if (typeof userDetail.last_login !== 'undefined' && userDetail.last_login) { %>
                                        <li style="padding:13px 0;border-bottom:none;display:flex;align-items:center;justify-content:space-between;gap:12px;">
                                            <span class="info-label" style="font-size:0.8rem;color:var(--gray-500);font-weight:600;">Last Login</span>
                                            <span class="info-value" style="font-size:0.9rem;color:var(--gray-900);font-weight:500;text-align:right;word-break:break-all;"><%= new Date(userDetail.last_login).toLocaleString() %></span>
                                        </li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>

                        <% if (typeof user !== 'undefined' && user && user.id != userDetail.id) { %>
                            <div class="panel">
                                <div class="panel-header">
                                    <h2>Manage Account</h2>
                                </div>
                                <div class="panel-body">
                                    <form method="POST" action="/admin/users/<%= userDetail.id %>/role">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <div class="field">
                                            <label for="role">Change Role</label>
                                            <select id="role" name="role">
                                                <option value="student" <%= userDetail.role === 'student' ? 'selected' : '' %>>Student</option>
                                                <option value="staff" <%= userDetail.role === 'staff' ? 'selected' : '' %>>Staff</option>
                                                <option value="admin" <%= userDetail.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-block" style="width:100%;">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/></svg>
                                            Update Role
                                        </button>
                                    </form>

                                    <div style="height:1px;background:var(--gray-200);margin:18px 0;"></div>

                                    <% if (userDetail.role === 'staff') { %>
                                        <form method="POST" action="/admin/users/<%= userDetail.id %>/department">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <div class="field">
                                                <label for="department_id">Staff Department</label>
                                                <select id="department_id" name="department_id">
                                                    <option value="">No department</option>
                                                    <% departments.forEach(department => { %>
                                                        <option value="<%= department.id %>" <%= userDetail.department_id == department.id ? 'selected' : '' %>><%= department.name %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <button type="submit" class="btn btn-outline btn-block" style="width:100%;">Update Department</button>
                                        </form>
                                        <div style="height:1px;background:var(--gray-200);margin:18px 0;"></div>
                                    <% } %>

                                    <form method="POST" action="/admin/users/<%= userDetail.id %>/toggle-active" onsubmit="return confirm('Toggle account status?');" style="margin-bottom:10px;">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <% if (typeof userDetail.is_active === false || userDetail.is_active === 0) { %>
                                            <button type="submit" class="btn btn-warn btn-block" style="width:100%;background:#fff7e6;color:#b45309;border:1px solid #fde68a;">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                                Activate Account
                                            </button>
                                        <% } else { %>
                                            <button type="submit" class="btn btn-danger btn-block" style="width:100%;background:#fdeeee;color:#b91c1c;border:1px solid #fecaca;">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                                Deactivate Account
                                            </button>
                                        <% } %>
                                    </form>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <div>
                        <div class="panel">
                            <div class="panel-header">
                                <h2>Submission Statistics</h2>
                            </div>
                            <div class="panel-body">
                                <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);gap:14px;margin:0;">
                                    <div class="stat-mini" style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:12px;padding:16px;text-align:center;">
                                        <div class="stat-mini-val a" style="color:var(--blue);font-size:1.5rem;font-weight:800;letter-spacing:-0.03em;line-height:1;margin-bottom:6px;"><%= userStats ? userStats.total : 0 %></div>
                                        <div class="stat-mini-label" style="font-size:0.72rem;color:var(--gray-500);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Total</div>
                                    </div>
                                    <div class="stat-mini" style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:12px;padding:16px;text-align:center;">
                                        <div class="stat-mini-val b" style="color:var(--warning);font-size:1.5rem;font-weight:800;letter-spacing:-0.03em;line-height:1;margin-bottom:6px;"><%= userStats ? userStats.pending : 0 %></div>
                                        <div class="stat-mini-label" style="font-size:0.72rem;color:var(--gray-500);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Pending</div>
                                    </div>
                                    <div class="stat-mini" style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:12px;padding:16px;text-align:center;">
                                        <div class="stat-mini-val c" style="color:var(--success);font-size:1.5rem;font-weight:800;letter-spacing:-0.03em;line-height:1;margin-bottom:6px;"><%= userStats ? userStats.resolved : 0 %></div>
                                        <div class="stat-mini-label" style="font-size:0.72rem;color:var(--gray-500);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Resolved</div>
                                    </div>
                                    <div class="stat-mini" style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:12px;padding:16px;text-align:center;">
                                        <div class="stat-mini-val d" style="color:var(--danger);font-size:1.5rem;font-weight:800;letter-spacing:-0.03em;line-height:1;margin-bottom:6px;"><%= userStats ? userStats.rejected : 0 %></div>
                                        <div class="stat-mini-label" style="font-size:0.72rem;color:var(--gray-500);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Rejected</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel-header">
                                <h2>Recent Submissions</h2>
                                <% if (typeof userSubmissions !== 'undefined' && userSubmissions && userSubmissions.length) { %>
                                    <a href="/admin/<%= userDetail.role === 'student' ? 'feedback' : 'feedback' %>" style="font-size:0.82rem;font-weight:650;color:var(--blue);text-decoration:none;">View all →</a>
                                <% } %>
                            </div>
                            <div class="panel-body">
                                <% if (typeof userSubmissions !== 'undefined' && userSubmissions && userSubmissions.length) { %>
                                    <div class="submissions-list" style="display:flex;flex-direction:column;gap:10px;">
                                        <% userSubmissions.forEach(function(sub) { %>
                                            <div class="sub-item" style="padding:14px 16px;border-radius:11px;border:1px solid var(--gray-200);background:var(--gray-50);display:flex;align-items:flex-start;justify-content:space-between;gap:14px;">
                                                <div class="sub-info" style="flex:1;min-width:0;">
                                                    <strong style="display:block;font-size:0.9rem;color:var(--navy-dark);margin-bottom:5px;"><%= sub.title %></strong>
                                                    <div class="sub-meta" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                                        <% if (sub.category_name) { %>
                                                            <span class="cat" style="background:#fff;padding:2px 9px;border-radius:999px;border:1px solid var(--gray-200);color:var(--gray-700);font-weight:600;font-size:0.75rem;"><%= sub.category_name %></span>
                                                        <% } %>
                                                        <% if (sub.status === 'Pending') { %>
                                                            <span class="badge badge-amber">Pending</span>
                                                        <% } else if (sub.status === 'Under Review') { %>
                                                            <span class="badge badge-blue">Under Review</span>
                                                        <% } else if (sub.status === 'In Progress') { %>
                                                            <span class="badge badge-violet">In Progress</span>
                                                        <% } else if (sub.status === 'Resolved') { %>
                                                            <span class="badge badge-green">Resolved</span>
                                                        <% } else if (sub.status === 'Rejected') { %>
                                                            <span class="badge badge-red">Rejected</span>
                                                        <% } else { %>
                                                            <span class="badge badge-blue"><%= sub.status %></span>
                                                        <% } %>
                                                        <span style="font-size:0.75rem;color:var(--gray-500);display:inline-flex;align-items:center;gap:5px;"><%= sub.created_at ? new Date(sub.created_at).toLocaleDateString() : '—' %></span>
                                                    </div>
                                                </div>
                                                <a href="/admin/submissions/<%= sub.id %>" class="btn-sm" style="padding:6px 12px;border-radius:7px;font-size:0.8rem;font-weight:600;background:var(--navy);color:#fff;text-decoration:none;display:inline-block;">View</a>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="empty-state" style="padding:40px 20px;text-align:center;">
                                        <div class="empty-icon" style="width:56px;height:56px;margin:0 auto 12px;border-radius:16px;background:var(--gray-100);display:grid;place-items:center;color:var(--gray-500);">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        </div>
                                        <h4 style="font-size:0.98rem;color:var(--navy-dark);margin-bottom:5px;">No submissions yet</h4>
                                        <p style="color:var(--gray-500);font-size:0.86rem;">This user hasn't made any submissions.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

            <% } %>
        </main>

        <footer class="app-footer">
            <p>&copy; <%= new Date().getFullYear() %> EduVoice — Admin Portal</p>
        </footer>
    </div>
</body>
</html>
