<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Feedback | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --navy: #12356a;
            --navy-dark: #0d2850;
            --blue: #2364bd;
            --blue-light: #4f91e8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --violet: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-500: #64748b;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7fb; color: var(--gray-900); margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: var(--navy); color: #fff; flex-shrink: 0; padding: 24px 0; }
        .sidebar-brand { display: flex; align-items: center; gap: 10px; padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand-icon { width: 38px; height: 38px; background: var(--blue); border-radius: 11px; display: grid; place-items: center; }
        .sidebar-brand-icon svg { width: 25px; height: 25px; color: #fff; }
        .sidebar-brand-name { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.04em; }
        .sidebar-menu { margin-top: 20px; padding: 0 12px; list-style: none; }
        .sidebar-menu li { margin: 4px 0; }
        .sidebar-menu a { display: block; padding: 11px 14px; border-radius: 9px; color: #c6d6ee; text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(79,145,232,0.15); color: #fff; }
        .sidebar-menu a.active { background: var(--blue); }
        .main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: #fff; border-bottom: 1px solid var(--gray-200); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar-title { font-size: 1.15rem; font-weight: 700; color: var(--navy-dark); }
        .topbar-user { display: flex; align-items: center; gap: 12px; }
        .topbar-user .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-weight: 700; }
        .topbar-user .user-name { font-weight: 650; font-size: 0.9rem; }
        .topbar-user .user-role { font-size: 0.78rem; color: var(--gray-500); }
        .page-content { padding: 28px 32px; flex: 1; }
        .page-header { margin-bottom: 24px; display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
        .page-header h1 { font-size: 1.7rem; color: var(--navy-dark); letter-spacing: -0.03em; margin-bottom: 4px; }
        .page-header p { color: var(--gray-500); font-size: 0.92rem; }
        .alert { padding: 13px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; }
        .alert-success { background: #e8f6ee; color: #15803d; border: 1px solid #bbf7d0; }
        .alert-error { background: #fdeeee; color: #b91c1c; border: 1px solid #fecaca; }
        .filters-panel { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); padding: 20px 22px; margin-bottom: 20px; box-shadow: 0 2px 10px rgba(15,23,42,0.04); }
        .filters-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 14px; align-items: end; }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .field label { font-size: 0.78rem; font-weight: 700; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; }
        .field input, .field select { padding: 10px 12px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.9rem; color: var(--gray-900); background: #fff; font-family: inherit; transition: border 0.15s, box-shadow 0.15s; }
        .field input:focus, .field select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(79,145,232,0.18); }
        .btn { padding: 10px 16px; border-radius: 8px; font-size: 0.88rem; font-weight: 650; font-family: inherit; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 7px; transition: all 0.15s; }
        .btn-primary { background: var(--blue); color: #fff; }
        .btn-primary:hover { background: var(--navy); }
        .btn-outline { background: #fff; color: var(--navy-dark); border: 1px solid var(--gray-300); }
        .btn-outline:hover { background: var(--gray-50); }
        .filters-actions { display: flex; gap: 8px; }
        .table-wrap { background: #fff; border-radius: 14px; border: 1px solid var(--gray-200); overflow: hidden; box-shadow: 0 2px 10px rgba(15,23,42,0.04); }
        .table { width: 100%; border-collapse: collapse; }
        .table thead th { text-align: left; font-size: 0.78rem; font-weight: 700; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em; padding: 14px 18px; border-bottom: 2px solid var(--gray-200); background: var(--gray-50); }
        .table tbody td { padding: 15px 18px; border-bottom: 1px solid var(--gray-100); font-size: 0.9rem; color: var(--gray-700); vertical-align: middle; }
        .table tbody tr:hover { background: var(--gray-50); }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 0.74rem; font-weight: 650; line-height: 1.3; }
        .badge-amber { background: #fff7e6; color: #b45309; }
        .badge-blue { background: #e8f1ff; color: #1e40af; }
        .badge-violet { background: #f3efff; color: #6d28d9; }
        .badge-green { background: #e8f6ee; color: #15803d; }
        .badge-red { background: #fdeeee; color: #b91c1c; }
        .link-id { font-weight: 600; color: var(--blue); font-family: 'Consolas', monospace; font-size: 0.82rem; }
        .student-cell strong { display: block; color: var(--gray-900); font-size: 0.88rem; }
        .student-cell small { color: var(--gray-500); font-size: 0.76rem; }
        .btn-view { padding: 6px 13px; border-radius: 7px; background: var(--navy); color: #fff; font-size: 0.82rem; font-weight: 600; text-decoration: none; display: inline-block; }
        .btn-view:hover { background: var(--navy-dark); }
        .empty-state { padding: 70px 30px; text-align: center; }
        .empty-icon { width: 72px; height: 72px; margin: 0 auto 18px; border-radius: 20px; background: #eef4ff; display: grid; place-items: center; color: var(--blue); }
        .empty-icon svg { width: 36px; height: 36px; }
        .empty-state h3 { font-size: 1.1rem; color: var(--navy-dark); margin-bottom: 6px; }
        .empty-state p { color: var(--gray-500); font-size: 0.92rem; max-width: 380px; margin: 0 auto; }
        .pagination { padding: 20px 24px; border-top: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; background: #fff; }
        .pagination-info { font-size: 0.85rem; color: var(--gray-500); }
        .pagination-info strong { color: var(--navy-dark); }
        .pagination-controls { display: flex; gap: 6px; align-items: center; }
        .page-btn { min-width: 36px; height: 36px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--gray-200); background: #fff; color: var(--gray-700); font-size: 0.85rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
        .page-btn:hover:not(:disabled):not(.current) { background: var(--gray-50); border-color: var(--gray-300); }
        .page-btn.current { background: var(--navy); color: #fff; border-color: var(--navy); }
        .page-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .dots { padding: 0 6px; color: var(--gray-500); }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="sidebar-brand-name">EduVoice</span>
            </div>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a></li>
                <li><a href="/admin/feedback" class="active">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Feedback
                </a></li>
                <li><a href="/admin/suggestions">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Suggestions
                </a></li>
                <li><a href="/admin/users">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Users
                </a></li>
                <li><a href="/admin/statistics">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Statistics
                </a></li>
                <li><a href="/admin/profile">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:10px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a></li>
            </ul>
        </aside>
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-title">Feedback Management</div>
                <div class="topbar-user">
                    <div style="text-align:right;">
                        <div class="user-name"><%= user ? user.name : 'Admin' %></div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <div class="avatar"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'A') : 'A' %></div>
                </div>
            </header>
            <main class="page-content">

                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <div class="page-header">
                    <div>
                        <h1>Feedback Submissions</h1>
                        <p>Review and manage all student feedback submissions.</p>
                    </div>
                </div>

                <form class="filters-panel" method="GET" action="/admin/feedback">
                    <div class="filters-grid">
                        <div class="field">
                            <label for="search">Search</label>
                            <input id="search" name="search" type="text" placeholder="Search by title, student, ID..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                        </div>
                        <div class="field">
                            <label for="category">Category</label>
                            <select id="category" name="category">
                                <option value="">All Categories</option>
                                <% if (typeof categories !== 'undefined' && categories) { %>
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat.id %>" <%= typeof selectedCategory !== 'undefined' && selectedCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="field">
                            <label for="status">Status</label>
                            <select id="status" name="status">
                                <option value="">All Statuses</option>
                                <% if (typeof statuses !== 'undefined' && statuses) { %>
                                    <% statuses.forEach(function(st) { %>
                                        <option value="<%= st %>" <%= typeof selectedStatus !== 'undefined' && selectedStatus === st ? 'selected' : '' %>><%= st %></option>
                                    <% }) %>
                                <% } else { %>
                                    <% ['Pending','Under Review','In Progress','Resolved','Rejected'].forEach(function(st) { %>
                                        <option value="<%= st %>" <%= typeof selectedStatus !== 'undefined' && selectedStatus === st ? 'selected' : '' %>><%= st %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="field">
                            <label for="dateFrom">Date From</label>
                            <input id="dateFrom" name="dateFrom" type="date" value="<%= typeof dateFrom !== 'undefined' ? dateFrom : '' %>">
                        </div>
                        <div class="filters-actions">
                            <button type="submit" class="btn btn-primary">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                Filter
                            </button>
                            <a href="/admin/feedback" class="btn btn-outline">Clear</a>
                        </div>
                    </div>
                </form>

                <div class="table-wrap">
                    <% if (typeof submissions !== 'undefined' && submissions && submissions.length) { %>
                        <div style="overflow-x:auto;">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Student</th>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% submissions.forEach(function(sub) { %>
                                        <tr>
                                            <td><span class="link-id">#<%= sub.id %></span></td>
                                            <td>
                                                <div class="student-cell">
                                                    <strong><%= sub.student_name || 'Anonymous' %></strong>
                                                    <% if (sub.student_id) { %><small>ID: <%= sub.student_id %></small><% } %>
                                                </div>
                                            </td>
                                            <td style="max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500;color:var(--gray-900);"><%= sub.title %></td>
                                            <td><%= sub.category_name || 'Uncategorized' %></td>
                                            <td>
                                                <% if (sub.status === 'Pending') { %>
                                                    <span class="badge badge-amber">Pending</span>
                                                <% } else if (sub.status === 'Under Review') { %>
                                                    <span class="badge badge-blue">Under Review</span>
                                                <% } else if (sub.status === 'In Progress') { %>
                                                    <span class="badge badge-violet">In Progress</span>
                                                <% } else if (sub.status === 'Resolved') { %>
                                                    <span class="badge badge-green">Resolved</span>
                                                <% } else if (sub.status === 'Rejected') { %>
                                                    <span class="badge badge-red">Rejected</span>
                                                <% } else { %>
                                                    <span class="badge badge-blue"><%= sub.status %></span>
                                                <% } %>
                                            </td>
                                            <td><%= new Date(sub.created_at).toLocaleDateString() %></td>
                                            <td>
                                                <a href="/admin/submissions/<%= sub.id %>" class="btn-view">View</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            </div>
                            <h3>No feedback found</h3>
                            <p>There are no feedback submissions matching your current filters. Try adjusting your search criteria.</p>
                        </div>
                    <% } %>

                    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                        <div class="pagination">
                            <div class="pagination-info">
                                Showing page <strong><%= typeof page !== 'undefined' ? page : 1 %></strong> of <strong><%= totalPages %></strong>
                            </div>
                            <div class="pagination-controls">
                                <%
                                    var currentPage = typeof page !== 'undefined' ? page : 1;
                                    var baseUrl = '/admin/feedback?';
                                    if (typeof searchQuery !== 'undefined' && searchQuery) baseUrl += 'search=' + encodeURIComponent(searchQuery) + '&';
                                    if (typeof selectedCategory !== 'undefined' && selectedCategory) baseUrl += 'category=' + encodeURIComponent(selectedCategory) + '&';
                                    if (typeof selectedStatus !== 'undefined' && selectedStatus) baseUrl += 'status=' + encodeURIComponent(selectedStatus) + '&';
                                    if (typeof dateFrom !== 'undefined' && dateFrom) baseUrl += 'dateFrom=' + encodeURIComponent(dateFrom) + '&';
                                    if (typeof dateTo !== 'undefined' && dateTo) baseUrl += 'dateTo=' + encodeURIComponent(dateTo) + '&';
                                %>
                                <a href="<%= baseUrl %>page=1" class="page-btn" <%= currentPage <= 1 ? 'disabled aria-disabled="true" tabindex="-1" style="pointer-events:none;"' : '' %> aria-label="First page">«</a>
                                <a href="<%= baseUrl %>page=<%= currentPage - 1 %>" class="page-btn" <%= currentPage <= 1 ? 'disabled aria-disabled="true" tabindex="-1" style="pointer-events:none;"' : '' %> aria-label="Previous page">‹</a>
                                <%
                                    var startPage = Math.max(1, currentPage - 2);
                                    var endPage = Math.min(totalPages, currentPage + 2);
                                    if (startPage > 1) { %><span class="dots">…</span><% }
                                    for (var p = startPage; p <= endPage; p++) {
                                %>
                                    <a href="<%= baseUrl %>page=<%= p %>" class="page-btn <%= p === currentPage ? 'current' : '' %>"><%= p %></a>
                                <%
                                    }
                                    if (endPage < totalPages) { %><span class="dots">…</span><% }
                                %>
                                <a href="<%= baseUrl %>page=<%= currentPage + 1 %>" class="page-btn" <%= currentPage >= totalPages ? 'disabled aria-disabled="true" tabindex="-1" style="pointer-events:none;"' : '' %> aria-label="Next page">›</a>
                                <a href="<%= baseUrl %>page=<%= totalPages %>" class="page-btn" <%= currentPage >= totalPages ? 'disabled aria-disabled="true" tabindex="-1" style="pointer-events:none;"' : '' %> aria-label="Last page">»</a>
                            </div>
                        </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>
</body>
</html>
