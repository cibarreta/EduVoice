<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head", { title: "Submissions | EduVoice" }) %>
</head>
<body>
    <div class="app-shell">
        <%- include("../partials/sidebar", { role: "staff" }) %>
        <div class="app-main">
            <div class="app-topbar">
                <button class="sidebar-toggle" type="button" aria-label="Toggle sidebar" aria-expanded="false" aria-controls="app-sidebar">
                    <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                        <path d="M4 7h16M4 12h16M4 17h16" stroke="#12356a" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </button>
                <div>
                    <h1 class="page-title">My Submissions</h1>
                    <p class="page-subtitle">Review and manage submissions assigned to you</p>
                </div>
                <div class="topbar-actions">
                    <a class="btn btn-outline" href="/staff/dashboard">Dashboard</a>
                </div>
            </div>
            <div class="app-content">
                <%- include("../partials/alerts") %>

                <div class="card" style="margin-bottom:1.5rem;">
                    <form method="GET" action="/staff/submissions" style="display:grid;grid-template-columns:1fr auto auto auto;gap:10px;align-items:end;">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Search</label>
                            <input type="text" name="q" class="form-control" placeholder="Search by title, reference..." value="<%= query.q || '' %>">
                        </div>
                        <div class="form-group" style="margin-bottom:0;min-width:160px;">
                            <label class="form-label">Category</label>
                            <select name="category" class="form-select">
                                <option value="">All Categories</option>
                                <% if (categories && categories.length) { categories.forEach(function(c) { %>
                                    <option value="<%= c.id %>" <%= query.category == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }) } %>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;min-width:150px;">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Status</option>
                                <option value="pending" <%= query.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="under_review" <%= query.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
                                <option value="in_progress" <%= query.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                                <option value="resolved" <%= query.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                                <option value="rejected" <%= query.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                            </select>
                        </div>
                        <div style="display:flex;gap:8px;">
                            <button type="submit" class="btn btn-primary" style="min-height:48px;">
                                <svg viewBox="0 0 24 24" fill="none" width="16" height="16">
                                    <path d="M21 21l-4.25-4.25M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Filter
                            </button>
                            <a href="/staff/submissions" class="btn btn-secondary" style="min-height:48px;">Reset</a>
                        </div>
                    </form>
                </div>

                <div class="card" style="padding:0;overflow:hidden;">
                    <% if (submissions && submissions.length > 0) { %>
                        <div class="responsive-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Type</th>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% submissions.forEach(function(sub) { %>
                                        <tr>
                                            <td style="font-weight:650;color:#12356a;"><%= sub.reference || '#' + sub.id %></td>
                                            <td>
                                                <span class="badge <%= sub.type === 'suggestion' ? 'badge-suggestion' : 'badge-feedback' %>" style="text-transform:capitalize;">
                                                    <%= sub.type %>
                                                </span>
                                            </td>
                                            <td style="font-weight:600;color:#172b4d;max-width:320px;">
                                                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= sub.title %></div>
                                            </td>
                                            <td><%= sub.category_name || 'General' %></td>
                                            <td>
                                                <span class="badge <%= sub.status === 'pending' ? 'badge-pending' : sub.status === 'under_review' ? 'badge-review' : sub.status === 'in_progress' ? 'badge-progress' : sub.status === 'resolved' ? 'badge-resolved' : 'badge-rejected' %>">
                                                    <%= (sub.status || 'pending').replace(/_/g, ' ') %>
                                                </span>
                                            </td>
                                            <td style="color:#65758a;font-size:0.82rem;"><%= new Date(sub.created_at).toLocaleDateString() %></td>
                                            <td>
                                                <a href="/staff/submissions/<%= sub.id %>" class="btn btn-outline" style="min-height:36px;padding:6px 12px;font-size:0.8rem;">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <% if (pagination && pagination.totalPages > 1) { %>
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1rem 1.5rem;border-top:1px solid #e7edf5;flex-wrap:wrap;">
                                <p style="font-size:0.82rem;color:#65758a;">
                                    Showing <%= pagination.from %>-<%= pagination.to %> of <%= pagination.total %>
                                </p>
                                <div style="display:flex;gap:6px;">
                                    <% if (pagination.page > 1) { %>
                                        <a class="btn btn-secondary" style="min-height:36px;padding:6px 12px;font-size:0.8rem;" href="/staff/submissions?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>">
                                            Previous
                                        </a>
                                    <% } %>
                                    <% for (var i = 1; i <= pagination.totalPages; i++) { %>
                                        <a class="btn <%= i === pagination.page ? 'btn-primary' : 'btn-secondary' %>" style="min-height:36px;min-width:36px;padding:6px 10px;font-size:0.8rem;" href="/staff/submissions?<%= new URLSearchParams({...query, page: i}).toString() %>">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                    <% if (pagination.page < pagination.totalPages) { %>
                                        <a class="btn btn-secondary" style="min-height:36px;padding:6px 12px;font-size:0.8rem;" href="/staff/submissions?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>">
                                            Next
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="empty-state">
                            <div style="width:56px;height:56px;margin:0 auto 16px;display:grid;place-items:center;border-radius:16px;background:#f3f6fa;color:#8090a4;">
                                <svg viewBox="0 0 24 24" fill="none" width="28" height="28">
                                    <path d="M5 5h14v15H5zM9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <h3>No submissions found</h3>
                            <p>Try adjusting your search filters, or check back later.</p>
                            <div style="margin-top:1.25rem;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
                                <a href="/staff/submissions" class="btn btn-secondary">Reset Filters</a>
                                <a href="/staff/dashboard" class="btn btn-primary">Back to Dashboard</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            var toggle = document.querySelector('.sidebar-toggle');
            var sidebar = document.querySelector('.app-sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            if (toggle && sidebar) {
                toggle.addEventListener('click', function(){
                    sidebar.classList.toggle('is-open');
                    if (overlay) overlay.classList.toggle('is-open');
                });
                if (overlay) {
                    overlay.addEventListener('click', function(){
                        sidebar.classList.remove('is-open');
                        overlay.classList.remove('is-open');
                    });
                }
            }
        });
    </script>
</body>
</html>
