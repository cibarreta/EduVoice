<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#12356a">
    <title>EduVoice</title>
    <link rel="icon" type="image/png" href="/images/eduvoice-mark.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <header class="auth-header">
        <a class="auth-brand" href="/" aria-label="EduVoice home">
            <span class="auth-brand-icon" aria-hidden="true"><img src="/images/eduvoice-mark.png" alt=""></span>
            <span>EduVoice</span>
        </a>
        <a class="auth-home-link" href="/">Back</a>
    </header>

    <main class="auth-layout">
        <section class="auth-story" aria-labelledby="auth-story-title">
            <p class="auth-eyebrow"><span></span> Student voice matters</p>
            <h1 id="auth-story-title">Your ideas belong in the conversation.</h1>
            <p class="auth-story-copy">Sign in to share your feedback, follow your submissions, and take part in shaping a better school community.</p>
            <div class="auth-illustration" aria-hidden="true">
                <div class="auth-illustration-orbit"></div>
                <div class="auth-message-card">
                    <span class="auth-message-icon">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <span><strong>Your voice matters</strong><small>Share what can make a difference</small></span>
                    <span class="auth-message-check">&#10003;</span>
                </div>
                <div class="auth-illustration-note">
                    <span class="auth-note-icon">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 20 6v5.5c0 5.1-3.45 8.6-8 10.5-4.55-1.9-8-5.4-8-10.5V6l8-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.2 2.2 4.8-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span><strong>A thoughtful community starts by listening.</strong></span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel" aria-labelledby="auth-title">
            <div class="auth-form-card">
                <p class="auth-form-kicker">Welcome back</p>
                <h2 id="auth-title">Log in to EduVoice</h2>
                <p class="auth-form-intro">Enter your account details to continue.</p>

                <% if (error) { %>
                    <div class="auth-error" role="alert"><%= error %></div>
                <% } %>

                <form class="auth-form" action="/login" method="POST">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="auth-field">
                        <label for="email">Email address</label>
                        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
                    </div>
                    <div class="auth-field">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
                    </div>
                    <button class="auth-submit" type="submit">Log In <span aria-hidden="true">&rarr;</span></button>
                </form>

                <p class="auth-switch">Don't have an account? <a href="/register">Create one</a></p>
                <p class="auth-form-footnote"><span aria-hidden="true">&#128274;</span> Your account keeps your EduVoice experience personal.</p>
            </div>
        </section>
    </main>
</body>
</html>
