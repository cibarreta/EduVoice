<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#12356a">
    <meta name="referrer" content="no-referrer">
    <title>Reset Password | EduVoice</title>
    <link rel="icon" type="image/png" href="/images/eduvoice-mark.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <header class="auth-header">
        <a class="auth-brand" href="/" aria-label="EduVoice home">
            <span class="auth-brand-icon" aria-hidden="true"><img src="/images/eduvoice-mark.png" alt=""></span>
            <span>EduVoice</span>
        </a>
        <a class="auth-home-link" href="/login">Back to login</a>
    </header>
    <main class="auth-layout auth-layout-register auth-layout-single">
        <section class="auth-form-panel" aria-labelledby="auth-title">
            <div class="auth-form-card">
                <p class="auth-form-kicker">Account recovery</p>
                <h2 id="auth-title">Set a new password</h2>
                <p class="auth-form-intro">Choose a new password with at least 8 characters.</p>
                <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
                <% if (token) { %>
                    <form class="auth-form" action="/reset-password" method="POST">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <input type="hidden" name="token" value="<%= token %>">
                        <div class="auth-field">
                            <label for="password">New password</label>
                            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
                        </div>
                        <div class="auth-field">
                            <label for="confirm_password">Confirm new password</label>
                            <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
                        </div>
                        <button class="auth-submit" type="submit">Change password <span aria-hidden="true">&rarr;</span></button>
                    </form>
                <% } else { %>
                    <p class="auth-switch"><a href="/forgot-password">Request a new reset link</a></p>
                <% } %>
                <p class="auth-switch"><a href="/login">Return to login</a></p>
            </div>
        </section>
    </main>
</body>
</html>
