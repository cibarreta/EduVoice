<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#12356a">
    <title>Create Account | EduVoice</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <header class="auth-header">
        <a class="auth-brand" href="/" aria-label="EduVoice home">
            <span class="auth-brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
            </span>
            <span>EduVoice</span>
        </a>
        <a class="auth-home-link" href="/">Back to home <span aria-hidden="true">&rarr;</span></a>
    </header>

    <main class="auth-layout auth-layout-register">
        <section class="auth-story" aria-labelledby="auth-story-title">
            <p class="auth-eyebrow"><span></span> Make your voice heard</p>
            <h1 id="auth-story-title">A better school community starts with you.</h1>
            <p class="auth-story-copy">Create your EduVoice account and share suggestions, concerns, and ideas that can help make a difference.</p>
            <div class="auth-illustration" aria-hidden="true">
                <div class="auth-illustration-orbit"></div>
                <div class="auth-message-card">
                    <span class="auth-message-icon">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 18.5 3.75 21l4.4-1.35c1.15.55 2.45.85 3.85.85 5.25 0 9.5-3.72 9.5-8.3S17.25 4 12 4 2.5 7.72 2.5 12.2c0 2.5 1.25 4.75 3.25 6.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 12h8M8 8.8h5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <span><strong>Every idea has a place</strong><small>Start a conversation at your school</small></span>
                    <span class="auth-message-check">&#10003;</span>
                </div>
                <div class="auth-illustration-note">
                    <span class="auth-note-icon">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 11a4 4 0 0 0 0-8M21 20v-1.5a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <span><strong>Listen. Share. Improve together.</strong></span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel" aria-labelledby="auth-title">
            <div class="auth-form-card">
                <p class="auth-form-kicker">Join the conversation</p>
                <h2 id="auth-title">Create your account</h2>
                <p class="auth-form-intro">Set up your student account to get started.</p>

                <% if (error) { %>
                    <div class="auth-error" role="alert"><%= error %></div>
                <% } %>

                <form class="auth-form" action="/register" method="POST">
                    <div class="auth-field">
                        <label for="student_id">Student ID</label>
                        <input id="student_id" name="student_id" type="text" autocomplete="username" placeholder="Enter your student ID" required>
                    </div>
                    <div class="auth-field">
                        <label for="name">Full name</label>
                        <input id="name" name="name" type="text" autocomplete="name" placeholder="Enter your full name" required>
                    </div>
                    <div class="auth-field">
                        <label for="email">Email address</label>
                        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
                    </div>
                    <div class="auth-field">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" aria-describedby="password-hint" placeholder="At least 8 characters" required>
                        <small class="auth-field-hint" id="password-hint">Use at least 8 characters.</small>
                    </div>
                    <button class="auth-submit" type="submit">Create Account <span aria-hidden="true">&rarr;</span></button>
                </form>

                <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
                <p class="auth-form-footnote"><span aria-hidden="true">&#128274;</span> Your account helps keep your submissions connected to you.</p>
            </div>
        </section>
    </main>
</body>
</html>
