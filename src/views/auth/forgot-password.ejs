<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#12356a">
    <title>Forgot Password | EduVoice</title>
    <link rel="icon" type="image/png" href="/images/eduvoice-mark.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <header class="auth-header">
        <a class="auth-brand" href="/" aria-label="EduVoice home">
            <span class="auth-brand-icon" aria-hidden="true"><img src="/images/eduvoice-mark.png" alt=""></span>
            <span>EduVoice</span>
        </a>
        <a class="auth-home-link" href="/login">Back to login</a>
    </header>
    <main class="auth-layout auth-layout-register auth-layout-single">
        <section class="auth-form-panel" aria-labelledby="auth-title">
            <div class="auth-form-card">
                <p class="auth-form-kicker">Account recovery</p>
                <h2 id="auth-title">Forgot your password?</h2>
                <p class="auth-form-intro">Enter your account email and we’ll send you a secure reset link if the account is active.</p>
                <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
                <% if (success) { %><div class="auth-success" role="status"><%= success %></div><% } %>
                <form class="auth-form" action="/forgot-password" method="POST">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="auth-field">
                        <label for="email">Email address</label>
                        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
                    </div>
                    <button class="auth-submit" type="submit">Send reset link <span aria-hidden="true">&rarr;</span></button>
                </form>
                <p class="auth-switch"><a href="/login">Return to login</a></p>
            </div>
        </section>
    </main>
</body>
</html>
